diff --git a/pkg/synchronization/endpoint/remote/completion.go b/pkg/synchronization/endpoint/remote/completion.go
new file mode 100644
index 0000000..3dbe8f1
--- /dev/null
+++ b/pkg/synchronization/endpoint/remote/completion.go
@@ -0,0 +1,54 @@
+package remote
+
+import (
+	"context"
+	"io"
+	"sync"
+)
+
+// onceCloser shares a single underlying closure between abort and shutdown.
+type onceCloser struct {
+	// close performs the underlying closure at most once and caches its result.
+	close func() error
+}
+
+// newOnceCloser wraps a closer so that it is only invoked once.
+func newOnceCloser(closer io.Closer) io.Closer {
+	return &onceCloser{close: sync.OnceValue(closer.Close)}
+}
+
+// Close implements io.Closer.Close.
+func (c *onceCloser) Close() error {
+	return c.close()
+}
+
+// waitForCompletion joins both sides of a completion exchange. A successful
+// first result still requires the other side's acknowledgement. A failed first
+// result aborts the raw transport before joining the remaining operation, since
+// a half-open transport cannot complete the exchange. The initiating failure is
+// preserved instead of the transport error induced by closure.
+func waitForCompletion(cancel context.CancelFunc, aborter io.Closer, first, second <-chan error) error {
+	var firstErr error
+	var remaining <-chan error
+	select {
+	case firstErr = <-first:
+		remaining = second
+	case firstErr = <-second:
+		remaining = first
+	}
+	cancel()
+
+	// Unblock the remaining operation if the exchange has already failed.
+	if firstErr != nil {
+		aborter.Close()
+		<-remaining
+		return firstErr
+	}
+
+	// Preserve the normal acknowledgement path when the first half succeeds.
+	if err := <-remaining; err != nil {
+		aborter.Close()
+		return err
+	}
+	return nil
+}
