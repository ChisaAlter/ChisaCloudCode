@@ -0,0 +1,325 @@
+package synchronization
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/test/bufconn"
+	"google.golang.org/protobuf/types/known/emptypb"
+
+	"github.com/mutagen-io/mutagen/pkg/encoding"
+	"github.com/mutagen-io/mutagen/pkg/filesystem"
+	"github.com/mutagen-io/mutagen/pkg/identifier"
+	"github.com/mutagen-io/mutagen/pkg/selection"
+	syncpkg "github.com/mutagen-io/mutagen/pkg/synchronization"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core/ignore"
+	_ "github.com/mutagen-io/mutagen/pkg/synchronization/protocols/local"
+	"github.com/mutagen-io/mutagen/pkg/url"
+)
+
+type ignoreUpdateHarness struct {
+	t                     *testing.T
+	data, alpha, beta, id string
+	manager               *syncpkg.Manager
+	connection            *grpc.ClientConn
+	server                *grpc.Server
+}
+
+func newIgnoreUpdateHarness(t *testing.T, configuration *syncpkg.Configuration, files map[string]string) *ignoreUpdateHarness {
+	t.Helper()
+	root := t.TempDir()
+	h := &ignoreUpdateHarness{t: t, data: filepath.Join(root, "data"), alpha: filepath.Join(root, "alpha"), beta: filepath.Join(root, "beta")}
+	t.Setenv("MUTAGEN_DATA_DIRECTORY", h.data)
+	for _, directory := range []string{h.alpha, h.beta} {
+		if err := os.MkdirAll(directory, 0700); err != nil {
+			t.Fatal(err)
+		}
+		for name, content := range files {
+			path := filepath.Join(directory, name)
+			if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	var err error
+	h.manager, err = syncpkg.NewManager(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { h.closeRPC(); h.manager.Shutdown() })
+	configuration.WatchMode = syncpkg.WatchMode_WatchModeNoWatch
+	configuration.ScanMode = syncpkg.ScanMode_ScanModeFull
+	alpha, err := url.Parse(h.alpha, url.Kind_Synchronization, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	beta, err := url.Parse(h.beta, url.Kind_Synchronization, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.id, err = h.manager.Create(context.Background(), alpha, beta, configuration, &syncpkg.Configuration{}, &syncpkg.Configuration{}, "ignore-update-test", nil, true, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.cycle()
+	h.startRPC()
+	return h
+}
+
+func (h *ignoreUpdateHarness) selected() *selection.Selection {
+	return &selection.Selection{Specifications: []string{h.id}}
+}
+
+func (h *ignoreUpdateHarness) cycle() {
+	h.t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	if err := h.manager.Resume(ctx, h.selected(), ""); err != nil {
+		h.t.Fatal(err)
+	}
+	// Resume starts the controller asynchronously. Wait on its state tracker,
+	// not elapsed time, before submitting a flush to the synchronization loop.
+	var index uint64
+	for {
+		nextIndex, states, err := h.manager.List(ctx, h.selected(), index)
+		if err != nil {
+			h.t.Fatal(err)
+		}
+		index = nextIndex
+		if states[0].LastError != "" {
+			h.t.Fatal(states[0].LastError)
+		}
+		if states[0].Status >= syncpkg.Status_Watching {
+			break
+		}
+	}
+	if err := h.manager.Flush(ctx, h.selected(), "", false); err != nil {
+		h.t.Fatal(err)
+	}
+	if err := h.manager.Pause(ctx, h.selected(), ""); err != nil {
+		h.t.Fatal(err)
+	}
+}
+
+func (h *ignoreUpdateHarness) startRPC() {
+	h.t.Helper()
+	listener := bufconn.Listen(1024 * 1024)
+	h.server = grpc.NewServer()
+	service := NewServer(h.manager)
+	RegisterSynchronizationServer(h.server, service)
+	RegisterIgnoreConfigurationServer(h.server, service)
+	go h.server.Serve(listener)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	connection, err := grpc.DialContext(ctx, "bufnet", grpc.WithContextDialer(func(context.Context, string) (net.Conn, error) { return listener.Dial() }), grpc.WithInsecure(), grpc.WithBlock())
+	if err != nil {
+		h.t.Fatal(err)
+	}
+	h.connection = connection
+	h.t.Cleanup(func() { listener.Close() })
+}
+
+func (h *ignoreUpdateHarness) closeRPC() {
+	if h.connection != nil {
+		h.connection.Close()
+		h.connection = nil
+	}
+	if h.server != nil {
+		h.server.Stop()
+		h.server = nil
+	}
+}
+
+func (h *ignoreUpdateHarness) update(ctx context.Context, id string, configuration *syncpkg.Configuration) error {
+	return h.connection.Invoke(ctx, IgnoreConfigurationUpdateMethod, &syncpkg.Session{Identifier: id, Configuration: configuration}, &emptypb.Empty{})
+}
+
+func (h *ignoreUpdateHarness) stored(directory string) []byte {
+	h.t.Helper()
+	data, err := os.ReadFile(filepath.Join(h.data, directory, h.id))
+	if err != nil {
+		h.t.Fatal(err)
+	}
+	return data
+}
+
+func (h *ignoreUpdateHarness) session() *syncpkg.Session {
+	h.t.Helper()
+	_, states, err := h.manager.List(context.Background(), h.selected(), 0)
+	if err != nil {
+		h.t.Fatal(err)
+	}
+	if len(states) != 1 || states[0].Session.Identifier != h.id {
+		h.t.Fatalf("unexpected session selection: %v", states)
+	}
+	return states[0].Session
+}
+
+func (h *ignoreUpdateHarness) requireContent(root, name, want string) {
+	h.t.Helper()
+	content, err := os.ReadFile(filepath.Join(root, name))
+	if err != nil || string(content) != want {
+		h.t.Fatalf("%s: content=%q, error=%v", filepath.Join(root, name), content, err)
+	}
+}
+
+func (h *ignoreUpdateHarness) requireAbsent(root, name string) {
+	h.t.Helper()
+	if _, err := os.Lstat(filepath.Join(root, name)); !os.IsNotExist(err) {
+		h.t.Fatalf("%s should be absent: %v", filepath.Join(root, name), err)
+	}
+}
+
+func TestIgnoreUpdateRejectsWithoutMutation(t *testing.T) {
+	h := newIgnoreUpdateHarness(t, &syncpkg.Configuration{}, map[string]string{"keep.txt": "keep"})
+	session, archive := h.stored(filesystem.MutagenSynchronizationSessionsDirectoryName), h.stored(filesystem.MutagenSynchronizationArchivesDirectoryName)
+	missing, err := identifier.New(identifier.PrefixSynchronization)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, test := range []struct {
+		name, id      string
+		configuration *syncpkg.Configuration
+	}{
+		{"name", "ignore-update-test", &syncpkg.Configuration{Ignores: []string{"cache"}}},
+		{"prefix", h.id[:12], &syncpkg.Configuration{Ignores: []string{"cache"}}},
+		{"missing", missing, &syncpkg.Configuration{Ignores: []string{"cache"}}},
+		{"invalid-pattern", h.id, &syncpkg.Configuration{Ignores: []string{"["}}},
+		{"other-setting", h.id, &syncpkg.Configuration{WatchPollingInterval: 1}},
+		{"missing-config", h.id, nil},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if err := h.update(context.Background(), test.id, test.configuration); err == nil {
+				t.Fatal("invalid request accepted")
+			}
+			if !bytes.Equal(session, h.stored(filesystem.MutagenSynchronizationSessionsDirectoryName)) || !bytes.Equal(archive, h.stored(filesystem.MutagenSynchronizationArchivesDirectoryName)) {
+				t.Fatal("rejected request changed persistent session or archive")
+			}
+		})
+	}
+	if err := h.manager.Resume(context.Background(), h.selected(), ""); err != nil {
+		t.Fatal(err)
+	}
+	running := h.stored(filesystem.MutagenSynchronizationSessionsDirectoryName)
+	if err := h.update(context.Background(), h.id, &syncpkg.Configuration{Ignores: []string{"keep.txt"}}); err == nil {
+		t.Fatal("running session accepted update")
+	}
+	if !bytes.Equal(running, h.stored(filesystem.MutagenSynchronizationSessionsDirectoryName)) || !bytes.Equal(archive, h.stored(filesystem.MutagenSynchronizationArchivesDirectoryName)) {
+		t.Fatal("running rejection changed persistent state")
+	}
+}
+
+func TestIgnoreUpdatePreservesArchiveAndRestarts(t *testing.T) {
+	h := newIgnoreUpdateHarness(t, &syncpkg.Configuration{IgnoreSyntax: ignore.Syntax_SyntaxDocker, IgnoreVCSMode: ignore.IgnoreVCSMode_IgnoreVCSModeIgnore, Ignores: []string{"old"}}, map[string]string{"keep.txt": "keep"})
+	archive := h.stored(filesystem.MutagenSynchronizationArchivesDirectoryName)
+	if err := h.update(context.Background(), h.id, &syncpkg.Configuration{Ignores: []string{"new"}}); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(archive, h.stored(filesystem.MutagenSynchronizationArchivesDirectoryName)) {
+		t.Fatal("update modified archive")
+	}
+	session := h.session()
+	if !session.Paused || session.Configuration.IgnoreSyntax != ignore.Syntax_SyntaxDocker || session.Configuration.IgnoreVCSMode != ignore.IgnoreVCSMode_IgnoreVCSModeIgnore || len(session.Configuration.Ignores) != 1 || session.Configuration.Ignores[0] != "new" {
+		t.Fatalf("paths-only update changed session semantics: %v", session)
+	}
+	h.closeRPC()
+	h.manager.Shutdown()
+	var err error
+	h.manager, err = syncpkg.NewManager(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.startRPC()
+	if session := h.session(); !session.Paused || session.Configuration.Ignores[0] != "new" {
+		t.Fatalf("restart lost paused configuration: %v", session)
+	}
+	if !bytes.Equal(archive, h.stored(filesystem.MutagenSynchronizationArchivesDirectoryName)) {
+		t.Fatal("restart modified archive")
+	}
+	stored := h.stored(filesystem.MutagenSynchronizationSessionsDirectoryName)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := h.update(ctx, h.id, &syncpkg.Configuration{Ignores: []string{"cancelled"}}); err == nil {
+		t.Fatal("cancelled RPC succeeded")
+	}
+	if err := h.manager.UpdateIgnores(ctx, h.id, &syncpkg.Configuration{Ignores: []string{"cancelled"}}); err == nil {
+		t.Fatal("cancelled manager operation succeeded")
+	}
+	if !bytes.Equal(stored, h.stored(filesystem.MutagenSynchronizationSessionsDirectoryName)) || !bytes.Equal(archive, h.stored(filesystem.MutagenSynchronizationArchivesDirectoryName)) {
+		t.Fatal("cancelled update changed persistent state")
+	}
+	if err := h.update(context.Background(), h.id, &syncpkg.Configuration{}); err != nil {
+		t.Fatal(err)
+	}
+	if len(h.session().Configuration.Ignores) != 0 {
+		t.Fatal("empty path update did not clear old paths")
+	}
+}
+
+func TestIgnoreUpdateKeepsCoveredPendingDeletion(t *testing.T) {
+	h := newIgnoreUpdateHarness(t, &syncpkg.Configuration{}, map[string]string{"keep.txt": "keep", "delete.txt": "remove", "cache.txt": "generated"})
+	if err := os.Remove(filepath.Join(h.alpha, "delete.txt")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(filepath.Join(h.alpha, "cache.txt")); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.update(context.Background(), h.id, &syncpkg.Configuration{Ignores: []string{"cache.txt"}}); err != nil {
+		t.Fatal(err)
+	}
+	h.cycle()
+	h.requireAbsent(h.beta, "delete.txt")
+	h.requireAbsent(h.alpha, "cache.txt")
+	h.requireContent(h.beta, "cache.txt", "generated")
+	h.requireContent(h.alpha, "keep.txt", "keep")
+	h.requireContent(h.beta, "keep.txt", "keep")
+}
+
+func TestIgnoreUpdateFileBecomesIgnoredDirectory(t *testing.T) {
+	h := newIgnoreUpdateHarness(t, &syncpkg.Configuration{}, map[string]string{"keep.txt": "keep", "cache": "preserve"})
+	if err := os.Remove(filepath.Join(h.alpha, "cache")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(filepath.Join(h.alpha, "cache"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.update(context.Background(), h.id, &syncpkg.Configuration{Ignores: []string{"cache/"}}); err != nil {
+		t.Fatal(err)
+	}
+	h.cycle()
+	h.requireContent(h.beta, "cache", "preserve")
+	if info, err := os.Stat(filepath.Join(h.alpha, "cache")); err != nil || !info.IsDir() {
+		t.Fatalf("ignored directory changed: %v", err)
+	}
+}
+
+func TestIgnoreUpdatePersistsProjectionWithoutOtherChanges(t *testing.T) {
+	h := newIgnoreUpdateHarness(t, &syncpkg.Configuration{}, map[string]string{"keep.txt": "keep", "cache.txt": "preserve"})
+	before := h.stored(filesystem.MutagenSynchronizationArchivesDirectoryName)
+	if err := h.update(context.Background(), h.id, &syncpkg.Configuration{Ignores: []string{"cache.txt"}}); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(before, h.stored(filesystem.MutagenSynchronizationArchivesDirectoryName)) {
+		t.Fatal("configuration update rewrote archive")
+	}
+	h.cycle()
+	archive := &core.Archive{}
+	if err := encoding.LoadAndUnmarshalProtobuf(filepath.Join(h.data, filesystem.MutagenSynchronizationArchivesDirectoryName, h.id), archive); err != nil {
+		t.Fatal(err)
+	}
+	if archive.Content.GetContents()["cache.txt"] != nil || archive.Content.GetContents()["keep.txt"] == nil {
+		t.Fatalf("coverage projection not saved: %v", archive)
+	}
+	h.requireContent(h.alpha, "cache.txt", "preserve")
+	h.requireContent(h.beta, "cache.txt", "preserve")
+}
