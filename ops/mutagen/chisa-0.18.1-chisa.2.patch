@@ -0,0 +1,52 @@
+package synchronization
+
+import (
+	"context"
+
+	"google.golang.org/grpc"
+	"google.golang.org/protobuf/types/known/emptypb"
+
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+)
+
+// IgnoreConfigurationUpdateMethod is the fork's additive daemon-only RPC.
+// Its request uses Session's existing wire type; only Identifier and
+// Configuration are consumed. The manager rejects non-ignore settings.
+const IgnoreConfigurationUpdateMethod = "/synchronization.IgnoreConfiguration/Update"
+
+type ignoreConfigurationServer interface {
+	UpdateIgnores(context.Context, *synchronization.Session) (*emptypb.Empty, error)
+}
+
+// UpdateIgnores updates a stopped session without changing its archive.
+func (s *Server) UpdateIgnores(ctx context.Context, request *synchronization.Session) (*emptypb.Empty, error) {
+	if err := s.manager.UpdateIgnores(ctx, request.Identifier, request.Configuration); err != nil {
+		return nil, err
+	}
+	return &emptypb.Empty{}, nil
+}
+
+// RegisterIgnoreConfigurationServer registers the additive fork service without
+// changing or regenerating the upstream Synchronization protobuf bindings.
+func RegisterIgnoreConfigurationServer(registrar grpc.ServiceRegistrar, server *Server) {
+	registrar.RegisterService(&grpc.ServiceDesc{
+		ServiceName: "synchronization.IgnoreConfiguration",
+		HandlerType: (*ignoreConfigurationServer)(nil),
+		Methods: []grpc.MethodDesc{{
+			MethodName: "Update",
+			Handler: func(srv interface{}, ctx context.Context, decode func(interface{}) error, interceptor grpc.UnaryServerInterceptor) (interface{}, error) {
+				request := new(synchronization.Session)
+				if err := decode(request); err != nil {
+					return nil, err
+				}
+				handler := func(ctx context.Context, request interface{}) (interface{}, error) {
+					return srv.(ignoreConfigurationServer).UpdateIgnores(ctx, request.(*synchronization.Session))
+				}
+				if interceptor == nil {
+					return handler(ctx, request)
+				}
+				return interceptor(ctx, request, &grpc.UnaryServerInfo{Server: srv, FullMethod: IgnoreConfigurationUpdateMethod}, handler)
+			},
+		}},
+	}, server)
+}
