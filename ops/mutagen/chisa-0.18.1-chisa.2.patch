index 0000000..08a6ea4
--- /dev/null
+++ b/pkg/synchronization/endpoint/remote/completion_protocol_test.go
@@ -0,0 +1,340 @@
+package remote_test
+
+import (
+	"context"
+	"errors"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/compression"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/endpoint/remote"
+)
+
+var errHalfFlow = errors.New("injected half-flow failure")
+
+// protocolFaultConnection preserves the stream contract: closing it unblocks
+// all pending reads and writes. Faults are armed only after real initialization.
+type protocolFaultConnection struct {
+	net.Conn
+	lock           sync.Mutex
+	mode           string
+	armed          bool
+	writes         int
+	requestRead    bool
+	requestWritten chan struct{}
+	requestOnce    sync.Once
+	fault          chan struct{}
+	faultOnce      sync.Once
+	closed         chan struct{}
+	closeOnce      sync.Once
+	closeCalls     atomic.Int32
+}
+
+func newProtocolFaultConnection(connection net.Conn) *protocolFaultConnection {
+	return &protocolFaultConnection{
+		Conn:           connection,
+		requestWritten: make(chan struct{}),
+		fault:          make(chan struct{}),
+		closed:         make(chan struct{}),
+	}
+}
+
+func (c *protocolFaultConnection) arm(mode string) {
+	c.lock.Lock()
+	c.mode, c.armed = mode, true
+	c.lock.Unlock()
+}
+
+func (c *protocolFaultConnection) Read(buffer []byte) (int, error) {
+	c.lock.Lock()
+	block := c.armed && (c.mode == "client" || (c.mode == "server-response" && c.requestRead))
+	fail := c.armed && (c.mode == "client-response" || (c.mode == "server" && c.requestRead))
+	c.lock.Unlock()
+	if fail {
+		c.faultOnce.Do(func() { close(c.fault) })
+		return 0, errHalfFlow
+	} else if block {
+		<-c.closed
+		return 0, net.ErrClosed
+	}
+
+	n, err := c.Conn.Read(buffer)
+	c.lock.Lock()
+	if c.armed && strings.HasPrefix(c.mode, "server") && n > 0 {
+		c.requestRead = true
+	}
+	c.lock.Unlock()
+	return n, err
+}
+
+func (c *protocolFaultConnection) Write(buffer []byte) (int, error) {
+	c.lock.Lock()
+	armed, mode := c.armed, c.mode
+	if armed {
+		c.writes++
+	}
+	writes := c.writes
+	c.lock.Unlock()
+	if armed && mode == "client" && writes >= 2 {
+		c.faultOnce.Do(func() { close(c.fault) })
+		return 0, errHalfFlow
+	} else if armed && mode == "client-response" && writes >= 2 {
+		<-c.closed
+		return 0, net.ErrClosed
+	} else if armed && mode == "server-response" {
+		c.faultOnce.Do(func() { close(c.fault) })
+		return 0, errHalfFlow
+	} else if armed && mode == "server" {
+		<-c.closed
+		return 0, net.ErrClosed
+	}
+
+	n, err := c.Conn.Write(buffer)
+	if armed && strings.HasPrefix(mode, "client") && writes == 1 && err == nil {
+		c.requestOnce.Do(func() { close(c.requestWritten) })
+	}
+	return n, err
+}
+
+// forceClose is the fixture's independent stop path, not a product Close call.
+func (c *protocolFaultConnection) forceClose() {
+	c.closeOnce.Do(func() {
+		close(c.closed)
+		c.Conn.Close()
+	})
+}
+
+func (c *protocolFaultConnection) Close() error {
+	c.closeCalls.Add(1)
+	c.forceClose()
+	return nil
+}
+
+type protocolPair struct {
+	endpoint     synchronization.Endpoint
+	client       *protocolFaultConnection
+	server       *protocolFaultConnection
+	root         string
+	serverDone   chan struct{}
+	serverErr    error
+	shutdownOnce sync.Once
+	shutdownErr  error
+}
+
+func newProtocolPair(t *testing.T, algorithm compression.Algorithm) *protocolPair {
+	t.Helper()
+	t.Setenv("MUTAGEN_DATA_DIRECTORY", t.TempDir())
+	client, server := net.Pipe()
+	pair := &protocolPair{
+		client:     newProtocolFaultConnection(client),
+		server:     newProtocolFaultConnection(server),
+		root:       t.TempDir(),
+		serverDone: make(chan struct{}),
+	}
+	go func() {
+		pair.serverErr = remote.ServeEndpoint(nil, pair.server)
+		close(pair.serverDone)
+	}()
+	var err error
+	pair.endpoint, err = remote.NewEndpoint(nil, pair.client, pair.root,
+		"completion-protocol", synchronization.DefaultVersion,
+		&synchronization.Configuration{
+			WatchMode:            synchronization.WatchMode_WatchModeNoWatch,
+			CompressionAlgorithm: algorithm,
+		}, false)
+	if err != nil {
+		pair.forceClose()
+		t.Fatal("unable to initialize real endpoint pair:", err)
+	}
+	t.Cleanup(func() {
+		pair.forceClose()
+		pair.shutdown()
+		awaitProtocolSignal(t, "server cleanup", pair.serverDone)
+	})
+	return pair
+}
+
+func (p *protocolPair) forceClose() {
+	p.client.forceClose()
+	p.server.forceClose()
+}
+
+func (p *protocolPair) shutdown() error {
+	p.shutdownOnce.Do(func() { p.shutdownErr = p.endpoint.Shutdown() })
+	return p.shutdownErr
+}
+
+func awaitProtocolSignal(t *testing.T, name string, signal <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-signal:
+	case <-time.After(3 * time.Second):
+		t.Fatal(name, "did not complete")
+	}
+}
+
+func protocolOperation(endpoint synchronization.Endpoint, method string, ctx context.Context) error {
+	switch method {
+	case "Poll":
+		return endpoint.Poll(ctx)
+	case "Scan":
+		_, err, _ := endpoint.Scan(ctx, nil, true)
+		return err
+	case "Transition":
+		_, _, _, err := endpoint.Transition(ctx, nil)
+		return err
+	default:
+		panic("unknown protocol operation")
+	}
+}
+
+// testCompletionHalfFlow exercises a real client/server exchange rather than
+// the completion helper. The opposite I/O half remains open and blocked until
+// the product closes the raw transport. Fixture cleanup can independently stop
+// the original implementation when it gets stuck.
+func testCompletionHalfFlow(t *testing.T, algorithm compression.Algorithm, side, method, mode string) {
+	t.Helper()
+	pair := newProtocolPair(t, algorithm)
+	faulty := pair.client
+	if side == "server" {
+		faulty = pair.server
+	}
+	faulty.arm(mode)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	result := make(chan error, 1)
+	go func() { result <- protocolOperation(pair.endpoint, method, ctx) }()
+	if mode == "client" {
+		awaitProtocolSignal(t, "real request transmission", faulty.requestWritten)
+		cancel()
+	}
+	awaitProtocolSignal(t, "half-flow injection", faulty.fault)
+	started := time.Now()
+	var operationErr error
+	if side == "client" {
+		select {
+		case operationErr = <-result:
+		case <-time.After(time.Second):
+			pair.forceClose()
+			<-result
+			t.Error("client stuck after half-flow failure with opposite I/O half open")
+			return
+		}
+	} else {
+		select {
+		case <-pair.serverDone:
+			operationErr = pair.serverErr
+		case <-time.After(time.Second):
+			pair.forceClose()
+			awaitProtocolSignal(t, "forced server stop", pair.serverDone)
+			<-result
+			t.Error("server stuck after half-flow failure with opposite I/O half open")
+			return
+		}
+		select {
+		case <-result:
+		case <-time.After(3 * time.Second):
+			t.Fatal("client did not observe server abort")
+		}
+	}
+	if !errors.Is(operationErr, errHalfFlow) {
+		t.Error("original transport error was lost:", operationErr)
+	}
+	var stage string
+	if side == "client" {
+		stage = "unable to send completion request"
+		if mode == "client-response" {
+			stage = "unable to receive " + strings.ToLower(method) + " response"
+		}
+	} else {
+		stage = "unable to serve " + strings.ToLower(method) + " request: unable to receive completion request"
+		if mode == "server-response" {
+			stage = "unable to serve " + strings.ToLower(method) + " request: unable to transmit response"
+		}
+	}
+	if operationErr == nil || !strings.Contains(operationErr.Error(), stage) {
+		t.Errorf("fault did not reach the intended %s protocol stage: %v", stage, operationErr)
+	}
+	pair.shutdown()
+	awaitProtocolSignal(t, "server exit", pair.serverDone)
+	if calls := faulty.closeCalls.Load(); calls != 1 {
+		t.Errorf("raw transport Close called %d times, expected once", calls)
+	}
+	t.Logf("real %s %s exchange exited in %s; cause retained; raw Close once; %v", mode, method, time.Since(started), operationErr)
+}
+
+// TestCompletionProtocolHalfFlow covers the six client/server completion
+// methods and both orderings of transport failure.
+func TestCompletionProtocolHalfFlow(t *testing.T) {
+	for _, algorithm := range []compression.Algorithm{
+		compression.Algorithm_AlgorithmNone,
+		compression.Algorithm_AlgorithmDeflate,
+	} {
+		for _, side := range []string{"client", "server"} {
+			for _, method := range []string{"Poll", "Scan", "Transition"} {
+				t.Run(algorithm.String()+"/"+side+"/"+method, func(t *testing.T) {
+					testCompletionHalfFlow(t, algorithm, side, method, side)
+				})
+			}
+		}
+	}
+
+	// Also exercise response-side failures arriving before the completion side.
+	// The DEFLATE cases cover these alternate wait orderings on the real wire.
+	t.Run("AlgorithmDeflate/client-response/Poll", func(t *testing.T) {
+		testCompletionHalfFlow(t, compression.Algorithm_AlgorithmDeflate, "client", "Poll", "client-response")
+	})
+	t.Run("AlgorithmDeflate/server-response/Scan", func(t *testing.T) {
+		testCompletionHalfFlow(t, compression.Algorithm_AlgorithmDeflate, "server", "Scan", "server-response")
+	})
+}
+
+func TestCompletionProtocolHealthy(t *testing.T) {
+	for _, algorithm := range []compression.Algorithm{
+		compression.Algorithm_AlgorithmNone,
+		compression.Algorithm_AlgorithmDeflate,
+	} {
+		t.Run(algorithm.String(), func(t *testing.T) {
+			pair := newProtocolPair(t, algorithm)
+			ctx, cancel := context.WithCancel(context.Background())
+			cancel()
+			if err := pair.endpoint.Poll(ctx); err != nil {
+				t.Fatal("normal Poll cancellation failed:", err)
+			}
+			if _, err, _ := pair.endpoint.Scan(context.Background(), nil, true); err != nil {
+				t.Fatal("Scan after normal cancellation failed:", err)
+			}
+			changes := []*core.Change{{Path: "ack-proof", New: &core.Entry{Kind: core.EntryKind_Directory}}}
+			results, problems, missing, err := pair.endpoint.Transition(context.Background(), changes)
+			if err != nil || len(results) != 1 || len(problems) != 0 || missing {
+				t.Fatalf("real directory transition failed: results=%v problems=%v missing=%v err=%v", results, problems, missing, err)
+			}
+			if info, err := os.Stat(filepath.Join(pair.root, "ack-proof")); err != nil || !info.IsDir() {
+				t.Fatal("Transition did not create the directory:", err)
+			}
+			snapshot, err, _ := pair.endpoint.Scan(context.Background(), nil, true)
+			if err != nil || snapshot == nil || snapshot.Content == nil || snapshot.Content.Contents["ack-proof"] == nil {
+				t.Fatal("post-Transition Scan did not observe directory:", err)
+			}
+			if pair.client.closeCalls.Load() != 0 || pair.server.closeCalls.Load() != 0 {
+				t.Fatal("healthy ACK or normal cancellation aborted the transport")
+			}
+			if err := pair.shutdown(); err != nil {
+				t.Fatal("healthy shutdown failed:", err)
+			}
+			awaitProtocolSignal(t, "healthy server exit", pair.serverDone)
+			if pair.client.closeCalls.Load() != 1 || pair.server.closeCalls.Load() != 1 {
+				t.Fatal("healthy endpoint shutdown did not close each raw transport once")
+			}
+			t.Log("normal cancellation ACK, subsequent Scan/Transition/Scan, directory on disk/state, and shutdown succeeded on the same transport")
+		})
+	}
+}
