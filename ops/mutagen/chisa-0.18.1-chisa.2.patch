+//go:build linux
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// synchronizationStdioStream owns pollable aliases of the agent's standard
+// streams. Unlike the generic stdioStream, Close must interrupt both protocol
+// halves so that ServeEndpoint can join them and shut down its local endpoint.
+// No other reader or writer may use standard input/output in synchronizer mode:
+// duplicated descriptors share O_NONBLOCK with the inherited descriptors.
+type synchronizationStdioStream struct {
+	input, output *os.File
+}
+
+func (s *synchronizationStdioStream) Read(buffer []byte) (int, error) {
+	return s.input.Read(buffer)
+}
+
+func (s *synchronizationStdioStream) Write(buffer []byte) (int, error) {
+	return s.output.Write(buffer)
+}
+
+func (s *synchronizationStdioStream) Close() error {
+	return errors.Join(s.input.Close(), s.output.Close())
+}
+
+// newSynchronizationStdioStream is specific to the Linux synchronization agent.
+// Make non-blocking descriptors before os.NewFile so Go registers them with its
+// runtime poller. Closing either File then wakes its pending I/O instead of
+// waiting for a blocking standard-stream syscall to return. No I/O deadline is
+// imposed; SetDeadline only verifies that registration succeeded.
+func newSynchronizationStdioStream() (io.ReadWriteCloser, error) {
+	open := func(original *os.File, name string) (*os.File, int, error) {
+		originalFD := original.Fd()
+		flags, err := unix.FcntlInt(originalFD, unix.F_GETFL, 0)
+		if err != nil {
+			return nil, 0, err
+		}
+		fd, err := unix.FcntlInt(originalFD, unix.F_DUPFD_CLOEXEC, 0)
+		if err != nil {
+			return nil, 0, err
+		}
+		if err = unix.SetNonblock(fd, true); err != nil {
+			unix.Close(fd)
+			return nil, 0, err
+		}
+		file := os.NewFile(uintptr(fd), name)
+		if err = file.SetDeadline(time.Time{}); err != nil {
+			file.Close()
+			unix.FcntlInt(originalFD, unix.F_SETFL, flags)
+			return nil, 0, fmt.Errorf("standard stream cannot support cancellable I/O: %w", err)
+		}
+		return file, flags, nil
+	}
+
+	input, inputFlags, err := open(os.Stdin, "synchronizer-input")
+	if err != nil {
+		return nil, fmt.Errorf("unable to initialize synchronization input: %w", err)
+	}
+	output, _, err := open(os.Stdout, "synchronizer-output")
+	if err != nil {
+		input.Close()
+		unix.FcntlInt(os.Stdin.Fd(), unix.F_SETFL, inputFlags)
+		return nil, fmt.Errorf("unable to initialize synchronization output: %w", err)
+	}
+	return &synchronizationStdioStream{input, output}, nil
+}
