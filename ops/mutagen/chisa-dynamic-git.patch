new file mode 100644
--- /dev/null
+++ b/pkg/synchronization/git_policy_tree_cache.go
@@ -0,0 +1,34 @@
+package synchronization
+
+import "github.com/mutagen-io/mutagen/pkg/synchronization/core"
+
+// Entry trees are immutable. These controller-local caches only avoid walking
+// the exact same objects; policy admission, scanning and transfer proofs remain
+// mandatory independently of these derived values.
+type entryProblemsCache struct {
+	content  *core.Entry
+	problems []*core.Problem
+	ready    bool
+}
+
+func (c *entryProblemsCache) problemsFor(content *core.Entry) []*core.Problem {
+	if !c.ready || c.content != content {
+		c.content = content
+		c.problems = content.Problems()
+		c.ready = true
+	}
+	return append([]*core.Problem(nil), c.problems...)
+}
+
+type emptyReconciliationCache struct {
+	ancestor, alpha, beta *core.Entry
+	mode                  core.SynchronizationMode
+	ready                 bool
+}
+
+func (c *emptyReconciliationCache) matches(ancestor, alpha, beta *core.Entry, mode core.SynchronizationMode) bool {
+	return c.ready && c.ancestor == ancestor && c.alpha == alpha && c.beta == beta && c.mode == mode
+}
+func (c *emptyReconciliationCache) remember(ancestor, alpha, beta *core.Entry, mode core.SynchronizationMode) {
+	*c = emptyReconciliationCache{ancestor: ancestor, alpha: alpha, beta: beta, mode: mode, ready: true}
+}
