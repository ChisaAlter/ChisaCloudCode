@@ -0,0 +1,56 @@
+package synchronization
+
+import (
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	"testing"
+)
+
+func TestGitPolicyImmutableTreeCaches(t *testing.T) {
+	var problems entryProblemsCache
+	if got := problems.problemsFor(nil); len(got) != 0 || !problems.ready {
+		t.Fatal("nil content was not cached explicitly")
+	}
+	first := &core.Entry{Kind: core.EntryKind_Directory, Contents: map[string]*core.Entry{"blocked": {Kind: core.EntryKind_Problematic, Problem: "permission denied"}}}
+	got := problems.problemsFor(first)
+	if len(got) != 1 || got[0].Error != "permission denied" {
+		t.Fatalf("problem lost: %v", got)
+	}
+	got[0] = nil
+	if again := problems.problemsFor(first); len(again) != 1 || again[0] == nil {
+		t.Fatal("published slice aliased cached problem slice")
+	}
+	changed := &core.Entry{Kind: core.EntryKind_Directory}
+	if got := problems.problemsFor(changed); len(got) != 0 {
+		t.Fatal("new immutable content retained old problems")
+	}
+	var empty emptyReconciliationCache
+	if empty.matches(nil, nil, nil, core.SynchronizationMode_SynchronizationModeTwoWaySafe) {
+		t.Fatal("uninitialized nil generation matched")
+	}
+	a, b := &core.Entry{Kind: core.EntryKind_File}, &core.Entry{Kind: core.EntryKind_File}
+	mode := core.SynchronizationMode_SynchronizationModeTwoWaySafe
+	empty.remember(first, a, b, mode)
+	if !empty.matches(first, a, b, mode) {
+		t.Fatal("exact immutable reconciliation generation not retained")
+	}
+	for _, candidate := range []struct {
+		x, y, z *core.Entry
+		m       core.SynchronizationMode
+	}{{changed, a, b, mode}, {first, changed, b, mode}, {first, a, changed, mode}, {first, a, b, core.SynchronizationMode_SynchronizationModeTwoWayResolved}} {
+		if empty.matches(candidate.x, candidate.y, candidate.z, candidate.m) {
+			t.Fatal("changed tree or synchronization mode reused empty result")
+		}
+	}
+	// A previous empty result must never hide a new conflict.
+	ancestor := &core.Entry{Kind: core.EntryKind_File, Digest: []byte("base")}
+	alpha := &core.Entry{Kind: core.EntryKind_File, Digest: []byte("alpha")}
+	beta := &core.Entry{Kind: core.EntryKind_File, Digest: []byte("beta")}
+	empty.remember(ancestor, ancestor, ancestor, mode)
+	if empty.matches(ancestor, alpha, beta, mode) {
+		t.Fatal("new divergent snapshots reused empty reconciliation")
+	}
+	_, _, _, conflicts := core.Reconcile(ancestor, alpha, beta, mode)
+	if len(conflicts) == 0 {
+		t.Fatal("new divergent content did not produce a conflict")
+	}
+}
