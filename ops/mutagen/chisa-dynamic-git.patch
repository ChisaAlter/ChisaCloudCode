+		if len(watcher.events) != 0 {
+			t.Fatal("event emitted after loss of topology proof")
+		}
+	}
+	t.Run("startup-topology-proof-loss", func(t *testing.T) {
+		watcher := &inotifyRecursiveWatcher{locations: map[int32]inotifyLocation{1: {directory: true}}, events: make(chan string, 1)}
+		if err := watcher.process(1, unix.IN_CREATE|unix.IN_ISDIR, "new", true); err == nil {
+			t.Fatal("startup topology mutation accepted")
+		}
+	})
+}
+
+func TestInotifyBudgetsAndUnsupportedFilesystem(t *testing.T) {
+	root := t.TempDir()
+	if err := os.Mkdir(filepath.Join(root, "one"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := newInotifyRecursiveWatcher(root, 2, 1); err == nil {
+		t.Fatal("directory budget was not enforced")
+	}
+	watcher := &inotifyRecursiveWatcher{events: make(chan string, 1)}
+	if err := watcher.emit(strings.Repeat("x", inotifyMaximumPathBytes+1)); err == nil {
+		t.Fatal("path byte budget was not enforced")
+	}
+	if _, err := NewRecursiveWatcher("/proc/self"); err == nil {
+		t.Fatal("unsupported proc filesystem accepted")
+	}
+	if _, err := NewRecursiveWatcher("/"); err == nil {
+		t.Fatal("filesystem root watch accepted")
+	}
+}
+
+func TestInotifyRejectsFIFORootWithoutBlocking(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "fifo")
+	if err := unix.Mkfifo(root, 0600); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		watcher, err := NewRecursiveWatcher(root)
+		if watcher != nil {
+			watcher.Terminate()
+		}
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("FIFO root accepted")
+		}
+	case <-time.After(maximumEventWaitTime):
+		t.Fatal("FIFO root blocked constructor")
+	}
+}
+
+func TestInotifyCancelledDrainDoesNotWaitForProducerIdle(t *testing.T) {
+	cancel := make(chan struct{})
+	close(cancel)
+	watcher := &inotifyRecursiveWatcher{cancel: cancel, fd: -1}
+	if err := watcher.drain(false); err != ErrWatchTerminated {
+		t.Fatalf("cancelled drain read before checking termination: %v", err)
+	}
+}
+
+func TestInotifyTerminateReleasesDescriptors(t *testing.T) {
+	watcher := inotifyTestWatcher(t, t.TempDir())
+	if err := watcher.Terminate(); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-watcher.Errors(); err != ErrWatchTerminated {
+		t.Fatal(err)
+	}
+	for _, fd := range []int{watcher.fd, watcher.epoll, watcher.stop} {
+		var metadata unix.Stat_t
+		if err := unix.Fstat(fd, &metadata); err != unix.EBADF {
+			t.Fatalf("descriptor %d still open: %v", fd, err)
+		}
+	}
+	if err := watcher.Terminate(); err != nil {
+		t.Fatal(err)
+	}
+}
