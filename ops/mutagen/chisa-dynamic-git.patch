--- /dev/null
+++ b/pkg/filesystem/watching/watch_recursive_linux_inotify.go
@@ -0,0 +1,445 @@
+//go:build linux && !(mutagensspl && mutagenfanotify)
+
+package watching
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	RecursiveWatchingSupported    = true
+	inotifyMaximumDirectories     = 100000
+	inotifyMaximumDepth           = 1024
+	inotifyMaximumPathBytes       = 4096
+	inotifyMaximumQueuedPathBytes = 16 * 1024 * 1024
+	inotifyEventCapacity          = inotifyMaximumQueuedPathBytes / inotifyMaximumPathBytes
+	inotifyRootCheckInterval      = 5 * time.Second
+	inotifyMask                   = unix.IN_MODIFY | unix.IN_ATTRIB | unix.IN_CLOSE_WRITE | unix.IN_CREATE | unix.IN_DELETE | unix.IN_MOVED_FROM | unix.IN_MOVED_TO | unix.IN_DELETE_SELF | unix.IN_MOVE_SELF | unix.IN_UNMOUNT
+)
+
+type inotifyLocation struct {
+	path      string
+	directory bool
+	parent    bool
+}
+
+type inotifyRecursiveWatcher struct {
+	root               string
+	rootName           string
+	rootStat           unix.Stat_t
+	fd                 int
+	epoll              int
+	stop               int
+	locations          map[int32]inotifyLocation
+	events             chan string
+	errors             chan error
+	done               chan struct{}
+	cancel             chan struct{}
+	terminate          sync.Once
+	descriptorLock     sync.Mutex
+	descriptorsClosed  bool
+	closeError         error
+	maximumDirectories int
+}
+
+func inotifySupportedFilesystem(fd int) error {
+	var metadata unix.Statfs_t
+	if err := unix.Fstatfs(fd, &metadata); err != nil {
+		return err
+	}
+	// Remote changes on NFS/CIFS/FUSE can bypass local inotify. Unknown and
+	// network filesystems retain the existing polling fallback. Overlay is
+	// excluded because writes through its lower filesystem can miss events.
+	switch uint64(metadata.Type) {
+	case unix.EXT4_SUPER_MAGIC, unix.XFS_SUPER_MAGIC, unix.BTRFS_SUPER_MAGIC, unix.TMPFS_MAGIC:
+		return nil
+	default:
+		return fmt.Errorf("filesystem does not provide verified local inotify semantics: 0x%x", metadata.Type)
+	}
+}
+
+// NewRecursiveWatcher establishes all directory watches before the endpoint's
+// baseline scan. Proof loss is fatal and returns control to its full-scan loop.
+func NewRecursiveWatcher(target string) (RecursiveWatcher, error) {
+	watcher, err := newInotifyRecursiveWatcher(target, inotifyMaximumDirectories, inotifyEventCapacity)
+	if err != nil {
+		return nil, err
+	}
+	return watcher, nil
+}
+
+func newInotifyRecursiveWatcher(target string, maximumDirectories, eventCapacity int) (*inotifyRecursiveWatcher, error) {
+	root, err := filepath.Abs(target)
+	if err != nil {
+		return nil, err
+	}
+	canonical, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return nil, err
+	}
+	if canonical != root || root == filepath.Dir(root) {
+		return nil, errors.New("watch target must be a canonical non-root path")
+	}
+	w := &inotifyRecursiveWatcher{root: root, rootName: filepath.Base(root), fd: -1, epoll: -1, stop: -1, locations: make(map[int32]inotifyLocation), events: make(chan string, eventCapacity), errors: make(chan error, 1), done: make(chan struct{}), cancel: make(chan struct{}), maximumDirectories: maximumDirectories}
+	failed := true
+	defer func() {
+		if failed {
+			w.closeDescriptors()
+		}
+	}()
+	w.fd, err = unix.InotifyInit1(unix.IN_CLOEXEC | unix.IN_NONBLOCK)
+	if err != nil {
+		return nil, err
+	}
+	w.epoll, err = unix.EpollCreate1(unix.EPOLL_CLOEXEC)
+	if err != nil {
+		return nil, err
+	}
+	w.stop, err = unix.Eventfd(0, unix.EFD_CLOEXEC|unix.EFD_NONBLOCK)
+	if err != nil {
+		return nil, err
+	}
+	for _, fd := range []int{w.fd, w.stop} {
+		if err := unix.EpollCtl(w.epoll, unix.EPOLL_CTL_ADD, fd, &unix.EpollEvent{Events: unix.EPOLLIN, Fd: int32(fd)}); err != nil {
+			return nil, err
+		}
+	}
+	parent, err := inotifyOpenNoFollow(filepath.Dir(root), true)
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(parent)
+	if err := inotifySupportedFilesystem(parent); err != nil {
+		return nil, err
+	}
+	if err := w.add(parent, inotifyLocation{parent: true, directory: true}); err != nil {
+		return nil, err
+	}
+	rootFD, err := unix.Openat(parent, w.rootName, unix.O_RDONLY|unix.O_NONBLOCK|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(rootFD)
+	if err := unix.Fstat(rootFD, &w.rootStat); err != nil {
+		return nil, err
+	}
+	kind := w.rootStat.Mode & unix.S_IFMT
+	if kind != unix.S_IFDIR && kind != unix.S_IFREG {
+		return nil, errors.New("watch target must be a directory or regular file")
+	}
+	if kind == unix.S_IFDIR {
+		err = w.arm(rootFD, "", 0)
+	} else {
+		err = w.add(rootFD, inotifyLocation{})
+	}
+	if err != nil {
+		return nil, err
+	}
+	if err := w.checkRoot(); err != nil {
+		return nil, err
+	}
+	// Topology changes while arming could hide an unobserved descendant.
+	// Ordinary file writes are covered by the subsequent full baseline scan.
+	if err := w.drain(true); err != nil {
+		return nil, err
+	}
+	failed = false
+	go w.run()
+	return w, nil
+}
+
+// Resolve each ancestor from a pinned directory with O_NOFOLLOW. A concurrent
+// rename can detach that inode, but cannot redirect an open through a symlink.
+// Its queued topology event then invalidates the entire watcher.
+func inotifyOpenNoFollow(absolute string, directory bool) (int, error) {
+	fd, err := unix.Open("/", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return -1, err
+	}
+	components := strings.Split(strings.TrimPrefix(absolute, "/"), "/")
+	if absolute == "/" {
+		return fd, nil
+	}
+	for index, component := range components {
+		if component == "" || component == "." || component == ".." {
+			unix.Close(fd)
+			return -1, errors.New("invalid absolute watch path")
+		}
+		flags := unix.O_RDONLY | unix.O_NONBLOCK | unix.O_NOFOLLOW | unix.O_CLOEXEC
+		if directory || index != len(components)-1 {
+			flags |= unix.O_DIRECTORY
+		}
+		next, err := unix.Openat(fd, component, flags, 0)
+		unix.Close(fd)
+		if err != nil {
+			return -1, err
+		}
+		fd = next
+	}
+	return fd, nil
+}
+
+func (w *inotifyRecursiveWatcher) add(fd int, location inotifyLocation) error {
+	if len(location.path) > inotifyMaximumPathBytes {
+		return errors.New("inotify relative path budget exceeded")
+	}
+	if len(w.locations) >= w.maximumDirectories {
+		return errors.New("inotify directory budget exceeded")
+	}
+	if err := inotifySupportedFilesystem(fd); err != nil {
+		return err
+	}
+	mask := uint32(inotifyMask)
+	if location.directory {
+		mask |= unix.IN_ONLYDIR
+	}
+	// The original entry was opened with O_NOFOLLOW. Do not set IN_DONT_FOLLOW
+	// here: /proc/self/fd/N is deliberately followed to that already pinned inode.
+	wd, err := unix.InotifyAddWatch(w.fd, fmt.Sprintf("/proc/self/fd/%d", fd), mask)
+	if err != nil {
+		return err
+	}
+	if _, exists := w.locations[int32(wd)]; exists {
+		return errors.New("duplicate directory inode in recursive watch")
+	}
+	w.locations[int32(wd)] = location
+	return nil
+}
+
+func (w *inotifyRecursiveWatcher) arm(fd int, relative string, depth int) error {
+	if depth > inotifyMaximumDepth {
+		return errors.New("inotify directory depth budget exceeded")
+	}
+	if err := w.add(fd, inotifyLocation{path: relative, directory: true}); err != nil {
+		return err
+	}
+	duplicate, err := unix.Dup(fd)
+	if err != nil {
+		return err
+	}
+	file := os.NewFile(uintptr(duplicate), "inotify-directory")
+	defer file.Close()
+	for {
+		entries, err := file.ReadDir(128)
+		if err != nil && err != io.EOF {
+			return err
+		}
+		for _, entry := range entries {
+			if !entry.IsDir() {
+				continue
+			}
+			child, err := unix.Openat(fd, entry.Name(), unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+			if err != nil {
+				return fmt.Errorf("directory changed while establishing watch: %w", err)
+			}
+			name := entry.Name()
+			if relative != "" {
+				name = relative + "/" + name
+			}
+			err = w.arm(child, name, depth+1)
+			unix.Close(child)
+			if err != nil {
+				return err
+			}
+		}
+		if err == io.EOF {
+			return nil
+		}
+	}
+}
+
+func (w *inotifyRecursiveWatcher) emit(relative string) error {
+	if len(relative) > inotifyMaximumPathBytes {
+		return errors.New("inotify relative path budget exceeded")
+	}
+	select {
+	case w.events <- relative:
+		return nil
+	default:
+		return ErrWatchInternalOverflow
+	}
+}
+
+func (w *inotifyRecursiveWatcher) process(wd int32, mask uint32, name string, startup bool) error {
+	if mask&unix.IN_Q_OVERFLOW != 0 {
+		return ErrWatchInternalOverflow
+	}
+	location, exists := w.locations[wd]
+	if !exists {
+		return errors.New("inotify watch identity lost")
+	}
+	if mask&(unix.IN_IGNORED|unix.IN_UNMOUNT|unix.IN_DELETE_SELF|unix.IN_MOVE_SELF) != 0 {
+		return errors.New("inotify watched inode moved or disappeared")
+	}
+	if strings.ContainsAny(name, "/\x00") || name == "." || name == ".." {
+		return errors.New("invalid inotify entry name")
+	}
+	if location.parent {
+		if name != w.rootName {
+			return nil
+		}
+		if mask&(unix.IN_CREATE|unix.IN_DELETE|unix.IN_MOVED_FROM|unix.IN_MOVED_TO) != 0 {
+			return errors.New("inotify watch root replaced")
+		}
+		if w.rootStat.Mode&unix.S_IFMT == unix.S_IFREG {
+			return w.emit("")
+		}
+		return nil
+	}
+	relative := location.path
+	if name != "" {
+		if relative != "" {
+			relative += "/"
+		}
+		relative += name
+	}
+	if mask&unix.IN_ISDIR != 0 && mask&(unix.IN_MOVED_FROM|unix.IN_DELETE) != 0 {
+		return errors.New("inotify directory topology changed")
+	}
+	if mask&unix.IN_ISDIR != 0 && mask&(unix.IN_CREATE|unix.IN_MOVED_TO) != 0 {
+		if startup {
+			return errors.New("directory topology changed during watch startup")
+		}
+		absolute := filepath.Join(w.root, filepath.FromSlash(relative))
+		fd, err := inotifyOpenNoFollow(absolute, true)
+		if err != nil {
+			return fmt.Errorf("new directory changed before arming: %w", err)
+		}
+		err = w.arm(fd, relative, strings.Count(relative, "/")+1)
+		unix.Close(fd)
+		if err != nil {
+			return err
+		}
+		// Emit the directory after arming: a full directory recheck covers files
+		// created before its own descriptors were installed.
+	}
+	return w.emit(relative)
+}
+
+func (w *inotifyRecursiveWatcher) drain(startup bool) error {
+	buffer := make([]byte, 64*1024)
+	for {
+		select {
+		case <-w.cancel:
+			return ErrWatchTerminated
+		default:
+		}
+		count, err := unix.Read(w.fd, buffer)
+		if err == unix.EAGAIN {
+			return nil
+		}
+		if err == unix.EINTR {
+			continue
+		}
+		if err != nil {
+			return err
+		}
+		if count == 0 {
+			return errors.New("inotify stream ended")
+		}
+		for offset := 0; offset < count; {
+			if count-offset < unix.SizeofInotifyEvent {
+				return errors.New("truncated inotify event")
+			}
+			event := buffer[offset:]
+			wd := int32(binary.NativeEndian.Uint32(event[0:4]))
+			mask := binary.NativeEndian.Uint32(event[4:8])
+			length := int(binary.NativeEndian.Uint32(event[12:16]))
+			if length > count-offset-unix.SizeofInotifyEvent {
+				return errors.New("truncated inotify name")
+			}
+			name := strings.TrimRight(string(event[16:16+length]), "\x00")
+			if err := w.process(wd, mask, name, startup); err != nil {
+				return err
+			}
+			offset += unix.SizeofInotifyEvent + length
+		}
+	}
+}
+
+func (w *inotifyRecursiveWatcher) checkRoot() error {
+	var current unix.Stat_t
+	if err := unix.Lstat(w.root, &current); err != nil {
+		return err
+	}
+	if current.Dev != w.rootStat.Dev || current.Ino != w.rootStat.Ino || current.Mode&unix.S_IFMT != w.rootStat.Mode&unix.S_IFMT {
+		return errors.New("inotify root path identity changed")
+	}
+	return nil
+}
+
+func (w *inotifyRecursiveWatcher) run() {
+	defer close(w.done)
+	defer w.closeDescriptors()
+	lastCheck := time.Now()
+	events := make([]unix.EpollEvent, 2)
+	for {
+		count, err := unix.EpollWait(w.epoll, events, 1000)
+		if err == unix.EINTR {
+			continue
+		}
+		if err != nil {
+			w.errors <- err
+			return
+		}
+		for _, event := range events[:count] {
+			if int(event.Fd) == w.stop {
+				w.errors <- ErrWatchTerminated
+				return
+			}
+		}
+		if time.Since(lastCheck) >= inotifyRootCheckInterval {
+			if err := w.checkRoot(); err != nil {
+				w.errors <- err
+				return
+			}
+			lastCheck = time.Now()
+		}
+		if err := w.drain(false); err != nil {
+			w.errors <- err
+			return
+		}
+	}
+}
+
+func (w *inotifyRecursiveWatcher) closeDescriptors() {
+	w.descriptorLock.Lock()
+	defer w.descriptorLock.Unlock()
+	if w.descriptorsClosed {
+		return
+	}
+	w.descriptorsClosed = true
+	for _, fd := range []int{w.fd, w.epoll, w.stop} {
+		if fd >= 0 {
+			if err := unix.Close(fd); err != nil && w.closeError == nil {
+				w.closeError = err
+			}
+		}
+	}
+}
+func (w *inotifyRecursiveWatcher) Events() <-chan string { return w.events }
+func (w *inotifyRecursiveWatcher) Errors() <-chan error  { return w.errors }
+func (w *inotifyRecursiveWatcher) Terminate() error {
+	w.terminate.Do(func() {
+		close(w.cancel)
+		w.descriptorLock.Lock()
+		if !w.descriptorsClosed {
+			var value [8]byte
+			binary.NativeEndian.PutUint64(value[:], 1)
+			unix.Write(w.stop, value[:])
+		}
+		w.descriptorLock.Unlock()
+		<-w.done
+	})
+	return w.closeError
+}
