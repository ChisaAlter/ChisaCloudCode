diff --git a/pkg/synchronization/update_ignores.go b/pkg/synchronization/update_ignores.go
new file mode 100644
--- /dev/null
+++ b/pkg/synchronization/update_ignores.go
@@ -0,0 +1,211 @@
+package synchronization
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"google.golang.org/protobuf/proto"
+
+	"github.com/mutagen-io/mutagen/pkg/encoding"
+	"github.com/mutagen-io/mutagen/pkg/identifier"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core/fastpath"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core/ignore"
+	dockerignore "github.com/mutagen-io/mutagen/pkg/synchronization/core/ignore/docker"
+	mutagenignore "github.com/mutagen-io/mutagen/pkg/synchronization/core/ignore/mutagen"
+)
+
+// IgnoreConfiguration extracts replacement ignore paths and optional syntax/VCS
+// overrides. An empty path list clears existing ignores instead of merging them.
+func IgnoreConfiguration(configuration *Configuration) *Configuration {
+	if configuration == nil {
+		return nil
+	}
+	return &Configuration{
+		IgnoreSyntax:   configuration.IgnoreSyntax,
+		DefaultIgnores: append([]string(nil), configuration.DefaultIgnores...),
+		Ignores:        append([]string(nil), configuration.Ignores...),
+		IgnoreVCSMode:  configuration.IgnoreVCSMode,
+	}
+}
+
+// NewIgnorer builds the same effective ignorer for endpoints and ancestors.
+func (c *Configuration) NewIgnorer(version Version) (ignore.Ignorer, error) {
+	syntax := c.IgnoreSyntax
+	if syntax.IsDefault() {
+		syntax = version.DefaultIgnoreSyntax()
+	}
+	patterns := append(append([]string(nil), c.DefaultIgnores...), c.Ignores...)
+	// The marker is a protocol opt-in, never a filesystem pattern.
+	filtered := patterns[:0]
+	for _, pattern := range patterns {
+		if pattern != GitPolicyMarker {
+			filtered = append(filtered, pattern)
+		}
+	}
+	patterns = filtered
+	var ignorer ignore.Ignorer
+	var err error
+	switch syntax {
+	case ignore.Syntax_SyntaxMutagen:
+		ignorer, err = mutagenignore.NewIgnorer(patterns)
+	case ignore.Syntax_SyntaxDocker:
+		ignorer, err = dockerignore.NewIgnorer(patterns)
+	default:
+		return nil, errors.New("unknown or unsupported ignore syntax")
+	}
+	if err != nil {
+		return nil, err
+	}
+	vcsMode := c.IgnoreVCSMode
+	if vcsMode.IsDefault() {
+		vcsMode = version.DefaultIgnoreVCSMode()
+	}
+	if vcsMode == ignore.IgnoreVCSMode_IgnoreVCSModeIgnore {
+		ignorer = ignore.IgnoreVCS(ignorer)
+	} else if vcsMode != ignore.IgnoreVCSMode_IgnoreVCSModePropagate {
+		return nil, errors.New("unknown or unsupported VCS ignore mode")
+	}
+	return ignorer, nil
+}
+
+// filterIgnoredAncestor projects the common ancestor onto the current coverage.
+// It never changes the archive on disk. Retained leaves (including the baseline
+// for deletions not yet propagated) are preserved exactly. Ignored ancestors
+// cannot become deletion instructions when the next snapshots omit them.
+func filterIgnoredAncestor(path string, entry *core.Entry, ignorer ignore.Ignorer, mask bool) *core.Entry {
+	if entry == nil {
+		return nil
+	}
+	directory := entry.Kind == core.EntryKind_Directory
+	if path != "" {
+		status, continueTraversal := ignorer.Ignore(path, directory)
+		switch status {
+		case ignore.IgnoreStatusNominal:
+			if mask && !continueTraversal {
+				return nil
+			}
+		case ignore.IgnoreStatusIgnored:
+			if !continueTraversal {
+				return nil
+			}
+			mask = true
+		case ignore.IgnoreStatusUnignored:
+			mask = false
+		}
+	}
+	if !directory {
+		return entry
+	}
+	result := entry.Copy(core.EntryCopyBehaviorSlim)
+	result.Contents = make(map[string]*core.Entry, len(entry.Contents))
+	for name, child := range entry.Contents {
+		if filtered := filterIgnoredAncestor(fastpath.Joinable(path)+name, child, ignorer, mask); filtered != nil {
+			result.Contents[name] = filtered
+		}
+	}
+	// An ignored directory is retained only as a parent of unignored content.
+	// The sync root itself is never subject to ignore matching.
+	if mask && len(result.Contents) == 0 {
+		return nil
+	}
+	return result
+}
+
+// filterUntrackedAncestor handles coverage changes whose current filesystem
+// kind differs from the archived kind (for example a file replaced by an
+// ignored directory). Either endpoint's explicit untracked marker takes that
+// path outside shared coverage. Absence alone does not: an absent tracked path
+// must retain its ancestor so its pending deletion can still propagate.
+func filterUntrackedAncestor(entry, alpha, beta *core.Entry) (*core.Entry, bool) {
+	if entry == nil {
+		return nil, false
+	}
+	if alpha != nil && alpha.Kind == core.EntryKind_Untracked || beta != nil && beta.Kind == core.EntryKind_Untracked {
+		return nil, true
+	}
+	if entry.Kind != core.EntryKind_Directory {
+		return entry, false
+	}
+	var result *core.Entry
+	alphaContents, betaContents := alpha.GetContents(), beta.GetContents()
+	for name, child := range entry.Contents {
+		filtered, changed := filterUntrackedAncestor(child, alphaContents[name], betaContents[name])
+		if !changed {
+			continue
+		}
+		if result == nil {
+			result = entry.Copy(core.EntryCopyBehaviorShallow)
+		}
+		if filtered == nil {
+			delete(result.Contents, name)
+		} else {
+			result.Contents[name] = filtered
+		}
+	}
+	if result != nil {
+		return result, true
+	}
+	return entry, false
+}
+
+// UpdateIgnores replaces ignore rules for one exact, paused session identifier.
+// It neither resets the archive nor connects or resumes either endpoint.
+func (m *Manager) UpdateIgnores(ctx context.Context, id string, configuration *Configuration) error {
+	if !identifier.IsValid(id) {
+		return errors.New("invalid exact session identifier")
+	}
+	if err := configuration.EnsureValid(false); err != nil {
+		return fmt.Errorf("invalid ignore configuration: %w", err)
+	}
+	if !proto.Equal(configuration, IgnoreConfiguration(configuration)) {
+		return errors.New("only ignore settings may be updated")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	m.sessionsLock.Lock()
+	c, ok := m.sessions[id]
+	m.sessionsLock.UnlockWithoutNotify()
+	if !ok {
+		return errors.New("exact session identifier not found")
+	}
+	c.lifecycleLock.Lock()
+	defer c.lifecycleLock.Unlock()
+	if c.disabled {
+		return errors.New("controller disabled")
+	}
+	c.stateLock.Lock()
+	defer c.stateLock.Unlock()
+	if !c.session.Paused || c.cancel != nil {
+		return errors.New("session must be paused and stopped before updating ignores")
+	}
+	// Save the complete new session atomically before publishing its settings.
+	// The archive stays untouched, so interruption can never pair a new archive
+	// with old rules or discard pending deletions in still-covered content.
+	next := proto.Clone(c.session).(*Session)
+	next.Configuration.DefaultIgnores = append([]string(nil), configuration.DefaultIgnores...)
+	next.Configuration.Ignores = append([]string(nil), configuration.Ignores...)
+	// Omitted enum settings retain the session's existing semantics. In
+	// particular, a paths-only update must not undo create's --ignore-vcs.
+	if !configuration.IgnoreSyntax.IsDefault() {
+		next.Configuration.IgnoreSyntax = configuration.IgnoreSyntax
+	}
+	if !configuration.IgnoreVCSMode.IsDefault() {
+		next.Configuration.IgnoreVCSMode = configuration.IgnoreVCSMode
+	}
+	if _, err := next.Configuration.NewIgnorer(c.session.Version); err != nil {
+		return fmt.Errorf("invalid ignore rules: %w", err)
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := encoding.MarshalAndSaveProtobuf(c.sessionPath, next); err != nil {
+		return fmt.Errorf("unable to persist ignore configuration: %w", err)
+	}
+	c.session.Configuration = next.Configuration
+	c.mergedAlphaConfiguration = MergeConfigurations(next.Configuration, c.session.ConfigurationAlpha)
+	c.mergedBetaConfiguration = MergeConfigurations(next.Configuration, c.session.ConfigurationBeta)
+	return nil
+}
