+package local
+
+import (
+	"context"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/mutagen-io/mutagen/pkg/logging"
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+)
+
+func policyWrite(t *testing.T, root, name, content string) {
+	t.Helper()
+	target := filepath.Join(root, filepath.FromSlash(name))
+	if err := os.MkdirAll(filepath.Dir(target), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(target, []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+}
+func policyCommand(t *testing.T, root string, args ...string) {
+	t.Helper()
+	if _, err := policyGit(context.Background(), root, nil, args...); err != nil {
+		t.Fatal(err)
+	}
+}
+func policyPair(t *testing.T) (*endpoint, *endpoint) {
+	t.Helper()
+	private := t.TempDir()
+	t.Setenv("MUTAGEN_DATA_DIRECTORY", filepath.Join(private, "daemon"))
+	t.Setenv("HOME", private)
+	t.Setenv("USERPROFILE", private)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(private, "xdg"))
+	var endpoints []*endpoint
+	for index, name := range []string{"alpha", "beta"} {
+		root := filepath.Join(private, name)
+		if err := os.MkdirAll(root, 0700); err != nil {
+			t.Fatal(err)
+		}
+		policyCommand(t, root, "init", "-q")
+		configuration := &synchronization.Configuration{Ignores: []string{synchronization.GitPolicyMarker}, WatchMode: synchronization.WatchMode_WatchModeNoWatch}
+		created, err := NewEndpoint(logging.NewLogger(logging.LevelError, io.Discard), root, "isolated-policy-test", synchronization.DefaultVersion, configuration, index == 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { created.Shutdown() })
+		endpoints = append(endpoints, created.(*endpoint))
+	}
+	return endpoints[0], endpoints[1]
+}
+func policyScan(t *testing.T, a, b *endpoint) (*core.Snapshot, *core.Snapshot) {
+	t.Helper()
+	if _, err := synchronization.PrepareGitPolicy(context.Background(), a, b, nil); err != nil {
+		t.Fatal(err)
+	}
+	aSnapshot, err, _ := a.Scan(context.Background(), nil, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bSnapshot, err, _ := b.Scan(context.Background(), nil, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return aSnapshot, bSnapshot
+}
+func policyEntry(snapshot *core.Snapshot, value string) *core.Entry {
+	entry := snapshot.Content
+	for _, part := range strings.Split(value, "/") {
+		if entry == nil {
+			return nil
+		}
+		entry = entry.Contents[part]
+	}
+	return entry
+}
+func requirePolicyEntry(t *testing.T, snapshot *core.Snapshot, value string, included bool) {
+	t.Helper()
+	entry := policyEntry(snapshot, value)
+	actual := entry != nil && entry.Kind != core.EntryKind_Untracked
+	if actual != included {
+		t.Fatalf("%s included=%t want=%t entry=%v", value, actual, included, entry)
+	}
+}
+
+func TestGitPolicyRealScanNewIgnoredAndOneIndexForceTracked(t *testing.T) {
+	a, b := policyPair(t)
+	for _, root := range []string{a.root, b.root} {
+		policyWrite(t, root, ".gitignore", "*.log\nruntime/\n")
+	}
+	policyScan(t, a, b) // future.log does not exist at startup.
+	policyWrite(t, a.root, "future.log", "must stay local")
+	policyWrite(t, a.root, "runtime/keep.txt", "force source")
+	policyWrite(t, a.root, "runtime/sibling.txt", "ignored sibling")
+	policyWrite(t, a.root, "normal.txt", "source")
+	snapshot, _ := policyScan(t, a, b)
+	requirePolicyEntry(t, snapshot, "future.log", false)
+	requirePolicyEntry(t, snapshot, "normal.txt", true)
+	requirePolicyEntry(t, snapshot, "runtime/keep.txt", false)
+	policyCommand(t, a.root, "add", "-f", "future.log", "runtime/keep.txt")
+	snapshot, _ = policyScan(t, a, b) // beta index deliberately never receives add -f.
+	requirePolicyEntry(t, snapshot, "future.log", true)
+	requirePolicyEntry(t, snapshot, "runtime/keep.txt", true)
+	requirePolicyEntry(t, snapshot, "runtime/sibling.txt", false)
+}
+func TestGitPolicyRealScanNewPathAfterCaptureDeniedThenAdmitted(t *testing.T) {
+	a, b := policyPair(t)
+	policyWrite(t, a.root, "first.txt", "one")
+	policyScan(t, a, b)
+	policyWrite(t, a.root, "later.txt", "two") // no watcher or recheck event.
+	snapshot, err, _ := a.Scan(context.Background(), nil, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	requirePolicyEntry(t, snapshot, "later.txt", false)
+	snapshot, _ = policyScan(t, a, b)
+	requirePolicyEntry(t, snapshot, "later.txt", true)
+}
+func TestGitPolicyChangesRejectStaleScanAndTransfer(t *testing.T) {
+	a, b := policyPair(t)
+	policyWrite(t, a.root, "source.txt", "one")
+	policyScan(t, a, b)
+	policyWrite(t, a.root, ".gitignore", "source.txt\n")
+	if _, err, _ := a.Scan(context.Background(), nil, true); err == nil {
+		t.Fatal("stale policy scan succeeded")
+	}
+	a.lockScanLock(context.Background())
+	err := a.admitGitPolicyPaths(context.Background(), []string{"source.txt"}, false)
+	a.unlockScanLock()
+	if err == nil {
+		t.Fatal("stale policy supplied a newly ignored path")
+	}
+	snapshot, _ := policyScan(t, a, b)
+	requirePolicyEntry(t, snapshot, "source.txt", false)
+	policyWrite(t, a.root, ".git/index.lock", "external owner")
+	if _, err := synchronization.PrepareGitPolicy(context.Background(), a, b, nil); err == nil {
+		t.Fatal("external index lock accepted")
+	}
+	if data, err := os.ReadFile(filepath.Join(a.root, ".git/index.lock")); err != nil || string(data) != "external owner" {
+		t.Fatal("external lock changed")
+	}
+}
+func TestGitPolicySecurityOverridesBothIndexes(t *testing.T) {
+	a, b := policyPair(t)
+	for _, name := range []string{".env", "src/.env.production", "node_modules/pkg/source.js", ".venv/lib.py", ".chisa-bridge.json", ".env.example", ".env.sample", "build/source.go"} {
+		policyWrite(t, a.root, name, "tracked")
+	}
+	policyCommand(t, a.root, "add", "-f", ".")
+	snapshot, _ := policyScan(t, a, b)
+	for _, name := range []string{".env", "src/.env.production", "node_modules/pkg/source.js", ".venv/lib.py", ".chisa-bridge.json"} {
+		requirePolicyEntry(t, snapshot, name, false)
+	}
+	for _, name := range []string{".env.example", ".env.sample", "build/source.go"} {
+		requirePolicyEntry(t, snapshot, name, true)
+	}
+}
+func TestGitPolicyWarmCaptureFreshCandidatesAndTrackedIsolation(t *testing.T) {
+	a, b := policyPair(t)
+	policyWrite(t, a.root, "old.txt", "old")
+	policyScan(t, a, b)
+	policyWrite(t, a.root, "new/.gitignore", "*.secret\n")
+	policyWrite(t, a.root, "new/private.secret", "ignored")
+	policyWrite(t, a.root, "new/public.txt", "new")
+	snapshot, _ := policyScan(t, a, b)
+	requirePolicyEntry(t, snapshot, "new/public.txt", true)
+	requirePolicyEntry(t, snapshot, "new/private.secret", false)
+	policyCommand(t, a.root, "add", "-f", "new/private.secret")
+	response, err := a.GitPolicy(context.Background(), &synchronization.GitPolicyRequest{Operation: "capture"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(response.Tracked) == 0 {
+		t.Fatal("changed index was not captured")
+	}
+	policyScan(t, a, b)
+	response, err = a.GitPolicy(context.Background(), &synchronization.GitPolicyRequest{Operation: "capture"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	unchanged, err := a.GitPolicy(context.Background(), &synchronization.GitPolicyRequest{Operation: "capture", Token: response.CaptureToken})
+	if err != nil || !unchanged.Unchanged || unchanged.Token == "" || unchanged.AdmissionToken == "" || len(unchanged.Paths) != 0 || len(unchanged.Tracked) != 0 {
+		t.Fatalf("fresh exact generation was not compact: %v %v", unchanged, err)
+	}
+	policyWrite(t, a.root, "fresh.txt", "fresh")
+	changed, err := a.GitPolicy(context.Background(), &synchronization.GitPolicyRequest{Operation: "capture", Token: response.CaptureToken})
+	if err != nil || changed.Unchanged || changed.CaptureToken == response.CaptureToken {
+		t.Fatalf("new candidate reused compact generation: %v %v", changed, err)
+	}
+	response.Tracked[0] = "mutated-by-caller"
+	if a.gitPolicyEvaluation.response.Tracked[0] == "mutated-by-caller" {
+		t.Fatal("capture aliased immutable tracked index")
+	}
+	policyWrite(t, a.root, ".git/index.lock", "external")
+	if _, err := a.GitPolicy(context.Background(), &synchronization.GitPolicyRequest{Operation: "capture"}); err == nil {
+		t.Fatal("warm capture ignored external index lock")
+	}
+}
+
+func TestGitPolicyScanCachedCountStillEnforcesGrowthLimit(t *testing.T) {
+	a, b := policyPair(t)
+	policyWrite(t, a.root, "one.txt", "one")
+	policyScan(t, a, b)
+	a.lockScanLock(context.Background())
+	old := a.snapshot.Content
+	count := a.lastScanEntryCount
+	if count != old.Count() {
+		t.Fatal("initial scan count is incorrect")
+	}
+	if err := a.scan(context.Background(), a.snapshot, nil); err != nil {
+		a.unlockScanLock()
+		t.Fatal(err)
+	}
+	if a.snapshot.Content != old || a.lastScanEntryCount != count {
+		a.unlockScanLock()
+		t.Fatal("unchanged immutable content did not retain exact count")
+	}
+	a.maximumEntryCount = count
+	a.unlockScanLock()
+	policyWrite(t, a.root, "two.txt", "two")
+	if _, err := synchronization.PrepareGitPolicy(context.Background(), a, b, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err, _ := a.Scan(context.Background(), nil, true); err == nil || !strings.Contains(err.Error(), "exceeded allowed entry count") {
+		t.Fatalf("new content bypassed entry limit: %v", err)
+	}
+	if a.lastScanEntryCount != count+1 {
+		t.Fatalf("new immutable tree count=%d want=%d", a.lastScanEntryCount, count+1)
+	}
+}
+
+func TestGitPolicyRenameAndMetadataEventLoss(t *testing.T) {
+	a, b := policyPair(t)
+	policyWrite(t, a.root, ".gitignore", "*.log\n")
+	policyWrite(t, a.root, "normal.txt", "one")
+	policyScan(t, a, b)
+	if err := os.Rename(filepath.Join(a.root, "normal.txt"), filepath.Join(a.root, "renamed.log")); err != nil {
+		t.Fatal(err)
+	}
+	snapshot, _ := policyScan(t, a, b)
+	requirePolicyEntry(t, snapshot, "renamed.log", false)
+	policyWrite(t, a.root, ".gitignore", "")
+	snapshot, _ = policyScan(t, a, b)
+	requirePolicyEntry(t, snapshot, "renamed.log", true)
+}
diff --git a/pkg/synchronization/endpoint/local/git_policy_witness.go b/pkg/synchronization/endpoint/local/git_policy_witness.go
new file mode 100644
--- /dev/null
+++ b/pkg/synchronization/endpoint/local/git_policy_witness.go
@@ -0,0 +1,267 @@
+package local
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+)
+
+// A witness hashes contents, not timestamps or watcher stamps. It enumerates
+// only policy inputs for the admitted candidates, never the working tree's data.
+// Git remains the semantic authority; this only permits reuse of its answer
+// while EVERY input and repository identity stays unchanged.
+type gitPolicyWitness struct {
+	root        string
+	rootInfo    fs.FileInfo
+	identities  map[string]fs.FileInfo
+	files       []string
+	directories []string
+	digest      string
+}
+type gitPolicyEvaluation struct {
+	paths    []string
+	response *synchronization.GitPolicyResponse
+	witness  *gitPolicyWitness
+}
+
+func newGitPolicyWitness(ctx context.Context, root string, repository bool, directories, paths []string) (*gitPolicyWitness, error) {
+	files := map[string]bool{}
+	add := func(value string) {
+		if value != "" {
+			if !filepath.IsAbs(value) {
+				value = filepath.Join(root, value)
+			}
+			files[filepath.Clean(value)] = true
+		}
+	}
+	// Changes to any ancestor .git can change selected-subtree/root identity.
+	for directory := filepath.Clean(root); ; directory = filepath.Dir(directory) {
+		add(filepath.Join(directory, ".git"))
+		if parent := filepath.Dir(directory); parent == directory {
+			break
+		}
+	}
+	for _, directory := range directories {
+		for _, name := range []string{"index", "HEAD", "commondir", "config", "config.worktree", "info/exclude"} {
+			add(filepath.Join(directory, name))
+		}
+	}
+	if len(directories) > 0 {
+		config, err := policyGit(ctx, root, nil, "config", "--null", "--show-origin", "--includes", "--list")
+		if err != nil {
+			return nil, err
+		}
+		fields := strings.Split(strings.TrimSuffix(string(config), "\x00"), "\x00")
+		if len(fields)%2 != 0 {
+			return nil, errors.New("invalid Git policy configuration origins")
+		}
+		for index := 0; index < len(fields); index += 2 {
+			origin := strings.TrimPrefix(fields[index], "file:")
+			if strings.HasPrefix(fields[index], "file:") {
+				add(origin)
+			}
+			key, value, _ := strings.Cut(fields[index+1], "\n")
+			// Include directives are inputs even when their target is absent.
+			if (key == "include.path" || strings.HasPrefix(key, "includeif.") && strings.HasSuffix(key, ".path")) && value != "" {
+				if strings.HasPrefix(value, "~") && !strings.HasPrefix(value, "~/") || strings.Contains(value, "%(prefix)") {
+					return nil, errors.New("unsupported Git include path expansion for policy proof")
+				}
+				if strings.HasPrefix(value, "~/") {
+					if home, err := os.UserHomeDir(); err == nil {
+						value = filepath.Join(home, value[2:])
+					} else {
+						return nil, err
+					}
+				}
+				if !filepath.IsAbs(value) && strings.HasPrefix(fields[index], "file:") {
+					if !filepath.IsAbs(origin) {
+						origin = filepath.Join(root, origin)
+					}
+					value = filepath.Join(filepath.Dir(origin), value)
+				}
+				add(value)
+			}
+		}
+		// git var includes absent default config files, which --show-origin
+		// cannot report. Unsupported Git versions fail closed, not to a cache.
+		for _, variable := range []string{"GIT_CONFIG_SYSTEM", "GIT_CONFIG_GLOBAL"} {
+			output, err := policyGit(ctx, root, nil, "var", variable)
+			if err != nil && !(variable == "GIT_CONFIG_SYSTEM" && os.Getenv("GIT_CONFIG_NOSYSTEM") != "" && policyExitCode(err, 1)) {
+				return nil, err
+			}
+			for _, value := range strings.Split(strings.TrimRight(string(output), "\r\n"), "\n") {
+				add(strings.TrimSuffix(value, "\r"))
+			}
+		}
+		output, err := policyGit(ctx, root, nil, "config", "--path", "--get", "core.excludesfile")
+		if err != nil && !policyExitCode(err, 1) {
+			return nil, err
+		}
+		if len(output) > 0 {
+			add(strings.TrimRight(string(output), "\r\n"))
+		}
+		// Git's default excludes file remains an input if not yet present.
+		if directory := os.Getenv("XDG_CONFIG_HOME"); directory != "" {
+			add(filepath.Join(directory, "git", "ignore"))
+		} else if home, err := os.UserHomeDir(); err == nil {
+			add(filepath.Join(home, ".config", "git", "ignore"))
+		} else {
+			return nil, err
+		}
+		output, err = policyGit(ctx, root, nil, "rev-parse", "--shared-index-path")
+		if err != nil {
+			return nil, err
+		}
+		add(strings.TrimRight(string(output), "\r\n"))
+		add(filepath.Join(root, ".gitignore"))
+		for _, value := range paths {
+			directory := filepath.Dir(filepath.FromSlash(value))
+			if strings.HasSuffix(value, "/") {
+				directory = filepath.FromSlash(strings.TrimSuffix(value, "/"))
+			}
+			for directory != "." && directory != "/" {
+				add(filepath.Join(root, directory, ".gitignore"))
+				parent := filepath.Dir(directory)
+				if parent == directory {
+					break
+				}
+				directory = parent
+			}
+		}
+	}
+	witness := &gitPolicyWitness{root: root, directories: directories, identities: make(map[string]fs.FileInfo)}
+	witness.rootInfo, _ = os.Stat(root)
+	for value := range files {
+		witness.files = append(witness.files, value)
+		if info, err := os.Stat(value); err == nil && info.IsDir() {
+			witness.identities[value] = info
+		}
+	}
+	for _, directory := range directories {
+		info, err := os.Stat(directory)
+		if err != nil {
+			return nil, err
+		}
+		witness.identities[directory] = info
+	}
+	sort.Strings(witness.files)
+	digest, err := witness.current(ctx)
+	if err != nil {
+		return nil, err
+	}
+	witness.digest = digest
+	return witness, nil
+}
+func (w *gitPolicyWitness) current(ctx context.Context) (string, error) {
+	if err := policyNoLocks(w.directories); err != nil {
+		return "", err
+	}
+	info, err := os.Stat(w.root)
+	if err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return "", err
+	}
+	if w.rootInfo != nil && (info == nil || !os.SameFile(w.rootInfo, info)) || w.rootInfo == nil && info != nil {
+		return "", errors.New("Git policy root identity changed")
+	}
+	for directory, original := range w.identities {
+		current, err := os.Stat(directory)
+		if err != nil || !os.SameFile(original, current) {
+			return "", errors.New("Git policy administrative identity changed")
+		}
+	}
+	hasher := sha256.New()
+	for _, value := range os.Environ() {
+		key := strings.ToUpper(strings.SplitN(value, "=", 2)[0])
+		if strings.HasPrefix(key, "GIT_CONFIG") || key == "HOME" || key == "USERPROFILE" || key == "XDG_CONFIG_HOME" {
+			fmt.Fprintf(hasher, "%s\x00", value)
+		}
+	}
+	for _, name := range w.files {
+		select {
+		case <-ctx.Done():
+			return "", ctx.Err()
+		default:
+		}
+		fmt.Fprintf(hasher, "%s\x00", name)
+		info, err := os.Lstat(name)
+		if errors.Is(err, fs.ErrNotExist) {
+			hasher.Write([]byte("absent\x00"))
+			continue
+		}
+		if err != nil {
+			return "", err
+		}
+		fmt.Fprintf(hasher, "%d\x00", info.Mode())
+		if info.IsDir() {
+			continue
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			target, err := os.Readlink(name)
+			if err != nil {
+				return "", err
+			}
+			fmt.Fprintf(hasher, "%s\x00", target)
+		}
+		targetInfo, err := os.Stat(name)
+		if errors.Is(err, fs.ErrNotExist) {
+			hasher.Write([]byte("broken-link\x00"))
+			continue
+		}
+		if err != nil {
+			return "", err
+		}
+		if targetInfo.IsDir() && w.identities[name] != nil {
+			continue
+		}
+		if !targetInfo.Mode().IsRegular() {
+			return "", errors.New("non-regular Git policy input")
+		}
+		if targetInfo.Size() > 64<<20 {
+			return "", errors.New("Git policy input exceeds 64 MiB proof bound")
+		}
+		file, err := os.Open(name)
+		if errors.Is(err, fs.ErrNotExist) {
+			hasher.Write([]byte("broken-link\x00"))
+			continue
+		}
+		if err != nil {
+			return "", err
+		}
+		read, err := io.Copy(hasher, io.LimitReader(file, (64<<20)+1))
+		if read > 64<<20 {
+			err = errors.New("Git policy input grew beyond 64 MiB proof bound")
+		}
+		closeErr := file.Close()
+		if err != nil {
+			return "", err
+		}
+		if closeErr != nil {
+			return "", closeErr
+		}
+		hasher.Write([]byte{0})
+	}
+	if err := policyNoLocks(w.directories); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(hasher.Sum(nil)), nil
+}
+func (w *gitPolicyWitness) valid(ctx context.Context) error {
+	digest, err := w.current(ctx)
+	if err != nil {
+		return err
+	}
+	if digest != w.digest {
+		return synchronization.NewGitPolicyRetry("Git policy inputs changed since admission")
+	}
+	return nil
+}
