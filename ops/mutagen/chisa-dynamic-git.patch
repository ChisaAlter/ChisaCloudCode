+package synchronization_test
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/mutagen-io/mutagen/pkg/logging"
+	"github.com/mutagen-io/mutagen/pkg/selection"
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	"github.com/mutagen-io/mutagen/pkg/url"
+)
+
+// retryWindowHandler holds the very next capture after a coherent retry so
+// observers can inspect the entire retry boundary without timing a short sleep.
+type retryWindowHandler struct {
+	base                                      synchronization.ProtocolHandler
+	connections                               atomic.Int64
+	mode                                      string
+	armed, fired                              atomic.Bool
+	blockedOnce                               atomic.Bool
+	blocked, release                          chan struct{}
+	injected, injectRelease, reconnectBlocked chan struct{}
+}
+type retryWindowEndpoint struct {
+	synchronization.Endpoint
+	policy  synchronization.GitPolicyEndpoint
+	handler *retryWindowHandler
+	alpha   bool
+}
+
+func (h *retryWindowHandler) Connect(ctx context.Context, logger *logging.Logger, u *url.URL, prompter, id string, version synchronization.Version, configuration *synchronization.Configuration, alpha bool) (synchronization.Endpoint, error) {
+	if alpha && h.mode == "hard-metadata" && h.fired.Load() && h.blockedOnce.CompareAndSwap(false, true) {
+		close(h.reconnectBlocked)
+		select {
+		case <-h.release:
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	endpoint, err := h.base.Connect(ctx, logger, u, prompter, id, version, configuration, alpha)
+	if err != nil {
+		return nil, err
+	}
+	h.connections.Add(1)
+	return &retryWindowEndpoint{Endpoint: endpoint, policy: endpoint.(synchronization.GitPolicyEndpoint), handler: h, alpha: alpha}, nil
+}
+func (e *retryWindowEndpoint) GitPolicy(ctx context.Context, request *synchronization.GitPolicyRequest) (*synchronization.GitPolicyResponse, error) {
+	h := e.handler
+	if e.alpha && h.armed.Load() {
+		if request.Operation == "capture" && h.fired.Load() && h.blockedOnce.CompareAndSwap(false, true) {
+			close(h.blocked)
+			select {
+			case <-h.release:
+			case <-ctx.Done():
+				return nil, ctx.Err()
+			}
+		}
+		op := "capture"
+		if h.mode == "validate" {
+			op = "validate"
+		}
+		if request.Operation == op && h.fired.CompareAndSwap(false, true) {
+			close(h.injected)
+			select {
+			case <-h.injectRelease:
+			case <-ctx.Done():
+				return nil, ctx.Err()
+			}
+			if h.mode == "hard-metadata" {
+				return nil, errors.New("injected Git metadata identity failure")
+			}
+			return nil, synchronization.NewGitPolicyRetry("injected coherent policy change")
+		}
+	}
+	return e.policy.GitPolicy(ctx, request)
+}
+
+func TestGitPolicyRetryWindowIsBusyWithoutFatalError(t *testing.T) {
+	for _, mode := range []string{"capture", "validate", "hard-metadata"} {
+		t.Run(mode, func(t *testing.T) {
+			private := t.TempDir()
+			t.Setenv("MUTAGEN_DATA_DIRECTORY", filepath.Join(private, "daemon"))
+			t.Setenv("HOME", private)
+			t.Setenv("USERPROFILE", private)
+			t.Setenv("GIT_CONFIG_GLOBAL", filepath.Join(private, "config"))
+			t.Setenv("GIT_CONFIG_NOSYSTEM", "1")
+			a, b := filepath.Join(private, "alpha"), filepath.Join(private, "beta")
+			for _, root := range []string{a, b} {
+				if err := os.MkdirAll(root, 0700); err != nil {
+					t.Fatal(err)
+				}
+				integrationGit(t, root, "init", "-q")
+			}
+			integrationWrite(t, a, "source.txt", "before")
+			previous := synchronization.ProtocolHandlers[url.Protocol_Local]
+			handler := &retryWindowHandler{base: previous, mode: mode, blocked: make(chan struct{}), release: make(chan struct{}), injected: make(chan struct{}), injectRelease: make(chan struct{}), reconnectBlocked: make(chan struct{})}
+			synchronization.ProtocolHandlers[url.Protocol_Local] = handler
+			defer func() { synchronization.ProtocolHandlers[url.Protocol_Local] = previous }()
+			manager, err := synchronization.NewManager(logging.NewLogger(logging.LevelError, io.Discard))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer manager.Shutdown()
+			defer func() {
+				for _, gate := range []chan struct{}{handler.injectRelease, handler.release} {
+					select {
+					case <-gate:
+					default:
+						close(gate)
+					}
+				}
+			}()
+			configuration := &synchronization.Configuration{Ignores: []string{synchronization.GitPolicyMarker}, WatchMode: synchronization.WatchMode_WatchModeForcePoll, WatchPollingInterval: 1, SynchronizationMode: core.SynchronizationMode_SynchronizationModeTwoWaySafe}
+			ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+			defer cancel()
+			id, err := manager.Create(ctx, &url.URL{Kind: url.Kind_Synchronization, Protocol: url.Protocol_Local, Path: a}, &url.URL{Kind: url.Kind_Synchronization, Protocol: url.Protocol_Local, Path: b}, configuration, &synchronization.Configuration{}, &synchronization.Configuration{}, "chisa-vps-retry-window", nil, false, "")
+			if err != nil {
+				t.Fatal(err)
+			}
+			selected := &selection.Selection{Specifications: []string{id}}
+			state := func() *synchronization.State {
+				t.Helper()
+				_, states, err := manager.List(ctx, selected, 0)
+				if err != nil || len(states) != 1 {
+					t.Fatalf("state unavailable: %v", err)
+				}
+				return states[0]
+			}
+			// Create connects asynchronously; arm only after its actual first
+			// successful cycle, so Flush is testing retry rather than startup.
+			integrationWait(t, manager, id, func() bool { return state().SuccessfulCycles > 0 })
+			if err := manager.Flush(ctx, selected, "", false); err != nil {
+				t.Fatal(err)
+			}
+			handler.armed.Store(true)
+			integrationWrite(t, a, "source.txt", "after")
+			flush := make(chan error, 1)
+			go func() { flush <- manager.Flush(ctx, selected, "", false) }()
+			select {
+			case <-handler.injected:
+			case <-ctx.Done():
+				t.Fatal("injection did not reach its barrier")
+			}
+			before := state().SuccessfulCycles
+			close(handler.injectRelease)
+			if mode == "hard-metadata" {
+				select {
+				case <-handler.reconnectBlocked:
+				case <-ctx.Done():
+					t.Fatal("hard metadata error did not abort synchronization")
+				}
+				if current := state(); !strings.Contains(current.LastError, "injected Git metadata identity failure") || current.Status == synchronization.Status_WaitingForRescan || current.SuccessfulCycles != 0 {
+					t.Fatal("hard metadata failure entered coherent retry or committed a cycle")
+				}
+				data, err := os.ReadFile(filepath.Join(b, "source.txt"))
+				if err != nil || string(data) != "before" {
+					t.Fatal("hard metadata failure transmitted current content")
+				}
+				select {
+				case err := <-flush:
+					if err == nil {
+						t.Fatal("hard metadata failure completed flush successfully")
+					}
+				case <-ctx.Done():
+					t.Fatal("hard metadata failure did not abort flush")
+				}
+				return
+			}
+			select {
+			case <-handler.blocked:
+			case <-ctx.Done():
+				t.Fatal("retry never reached the gated next capture")
+			}
+			current := state()
+			if current.Status != synchronization.Status_WaitingForRescan || current.LastError != "" || current.SuccessfulCycles != before || !current.AlphaState.Connected || !current.BetaState.Connected {
+				t.Fatalf("retry exposed fatal or ready state: %v", current)
+			}
+			if handler.connections.Load() != 2 {
+				t.Fatal("coherent retry reconnected endpoints")
+			}
+			data, err := os.ReadFile(filepath.Join(b, "source.txt"))
+			if err != nil || string(data) != "before" {
+				t.Fatal("retry window transmitted unproven content")
+			}
+			select {
+			case err := <-flush:
+				t.Fatalf("flush crossed unfinished retry: %v", err)
+			default:
+			}
+			close(handler.release)
+			select {
+			case err := <-flush:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-ctx.Done():
+				t.Fatal("released retry did not complete flush")
+			}
+			data, err = os.ReadFile(filepath.Join(b, "source.txt"))
+			if err != nil || string(data) != "after" {
+				t.Fatal("released retry did not converge current archive content")
+			}
+			if handler.connections.Load() != 2 || state().SuccessfulCycles <= before {
+				t.Fatal("retry did not commit on the original endpoints")
+			}
+		})
+	}
+}
+
+type retryPolicyHandler struct {
+	base                 synchronization.ProtocolHandler
+	connections, retries atomic.Int64
+	operation            string
+}
+type retryPolicyEndpoint struct {
+	synchronization.Endpoint
+	policy synchronization.GitPolicyEndpoint
+	counts *retryPolicyHandler
+}
+
+func (h *retryPolicyHandler) Connect(ctx context.Context, l *logging.Logger, u *url.URL, prompter, id string, v synchronization.Version, c *synchronization.Configuration, a bool) (synchronization.Endpoint, error) {
+	endpoint, err := h.base.Connect(ctx, l, u, prompter, id, v, c, a)
+	if err != nil {
+		return nil, err
+	}
+	h.connections.Add(1)
+	return &retryPolicyEndpoint{endpoint, endpoint.(synchronization.GitPolicyEndpoint), h}, nil
+}
+func (e *retryPolicyEndpoint) GitPolicy(ctx context.Context, q *synchronization.GitPolicyRequest) (*synchronization.GitPolicyResponse, error) {
+	if q.Operation == e.counts.operation && e.counts.retries.CompareAndSwap(0, 1) {
+		return nil, synchronization.NewGitPolicyRetry("injected coherent policy change")
+	}
+	return e.policy.GitPolicy(ctx, q)
+}
+func TestGitPolicyCoherentRetryKeepsEndpointsAndArchive(t *testing.T) {
+	for _, operation := range []string{"capture", "validate"} {
+		t.Run(operation, func(t *testing.T) {
+			private := t.TempDir()
+			t.Setenv("MUTAGEN_DATA_DIRECTORY", filepath.Join(private, "daemon"))
+			t.Setenv("HOME", private)
+			t.Setenv("USERPROFILE", private)
+			t.Setenv("GIT_CONFIG_GLOBAL", filepath.Join(private, "config"))
+			t.Setenv("GIT_CONFIG_NOSYSTEM", "1")
+			a, b := filepath.Join(private, "alpha"), filepath.Join(private, "beta")
+			for _, root := range []string{a, b} {
+				if err := os.MkdirAll(root, 0700); err != nil {
+					t.Fatal(err)
+				}
+				integrationGit(t, root, "init", "-q")
+			}
+			integrationWrite(t, a, "source.txt", "source")
+			previous := synchronization.ProtocolHandlers[url.Protocol_Local]
+			counts := &retryPolicyHandler{base: previous, operation: operation}
+			synchronization.ProtocolHandlers[url.Protocol_Local] = counts
+			defer func() { synchronization.ProtocolHandlers[url.Protocol_Local] = previous }()
+			manager, err := synchronization.NewManager(logging.NewLogger(logging.LevelError, io.Discard))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer manager.Shutdown()
+			config := &synchronization.Configuration{Ignores: []string{synchronization.GitPolicyMarker}, WatchMode: synchronization.WatchMode_WatchModeForcePoll, WatchPollingInterval: 1, SynchronizationMode: core.SynchronizationMode_SynchronizationModeTwoWaySafe}
+			id, err := manager.Create(context.Background(), &url.URL{Kind: url.Kind_Synchronization, Protocol: url.Protocol_Local, Path: a}, &url.URL{Kind: url.Kind_Synchronization, Protocol: url.Protocol_Local, Path: b}, config, &synchronization.Configuration{}, &synchronization.Configuration{}, "chisa-vps-retry-test", nil, false, "")
+			if err != nil {
+				t.Fatal(err)
+			}
+			integrationWait(t, manager, id, func() bool {
+				data, err := os.ReadFile(filepath.Join(b, "source.txt"))
+				return err == nil && string(data) == "source"
+			})
+			if counts.connections.Load() != 2 || counts.retries.Load() != 1 {
+				t.Fatalf("coherent retry reconnected: connections=%d retries=%d", counts.connections.Load(), counts.retries.Load())
+			}
+			integrationWrite(t, a, "source.txt", "changed")
+			integrationWait(t, manager, id, func() bool {
+				data, err := os.ReadFile(filepath.Join(b, "source.txt"))
+				return err == nil && string(data) == "changed"
+			})
+			if counts.connections.Load() != 2 {
+				t.Fatal("postretry normal save reconnected")
+			}
+		})
+	}
+}
