new file mode 100644
--- /dev/null
+++ b/pkg/synchronization/git_policy_idle_test.go
@@ -0,0 +1,130 @@
+package synchronization_test
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/mutagen-io/mutagen/pkg/logging"
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	"github.com/mutagen-io/mutagen/pkg/url"
+)
+
+type policyCountingHandler struct {
+	base                                      synchronization.ProtocolHandler
+	connections, captures, evaluations, scans atomic.Int64
+}
+type policyCountingEndpoint struct {
+	synchronization.Endpoint
+	policy synchronization.GitPolicyEndpoint
+	counts *policyCountingHandler
+}
+
+func (h *policyCountingHandler) Connect(ctx context.Context, logger *logging.Logger, endpoint *url.URL, prompter, session string, version synchronization.Version, configuration *synchronization.Configuration, alpha bool) (synchronization.Endpoint, error) {
+	created, err := h.base.Connect(ctx, logger, endpoint, prompter, session, version, configuration, alpha)
+	if err != nil {
+		return nil, err
+	}
+	h.connections.Add(1)
+	return &policyCountingEndpoint{created, created.(synchronization.GitPolicyEndpoint), h}, nil
+}
+func (e *policyCountingEndpoint) GitPolicy(ctx context.Context, request *synchronization.GitPolicyRequest) (*synchronization.GitPolicyResponse, error) {
+	if request.Operation == "capture" {
+		e.counts.captures.Add(1)
+	}
+	if request.Operation == "evaluate" {
+		e.counts.evaluations.Add(1)
+	}
+	return e.policy.GitPolicy(ctx, request)
+}
+func (e *policyCountingEndpoint) Scan(ctx context.Context, ancestor *core.Entry, full bool) (*core.Snapshot, error, bool) {
+	e.counts.scans.Add(1)
+	return e.Endpoint.Scan(ctx, ancestor, full)
+}
+
+func TestGitPolicyAutonomousIdleBoundary100Seconds(t *testing.T) {
+	if testing.Short() {
+		t.Skip("100 second isolation boundary")
+	}
+	private := t.TempDir()
+	t.Setenv("MUTAGEN_DATA_DIRECTORY", filepath.Join(private, "daemon"))
+	t.Setenv("HOME", private)
+	t.Setenv("USERPROFILE", private)
+	t.Setenv("GIT_CONFIG_GLOBAL", filepath.Join(private, "config"))
+	t.Setenv("GIT_CONFIG_NOSYSTEM", "1")
+	a, b := filepath.Join(private, "alpha"), filepath.Join(private, "beta")
+	for _, root := range []string{a, b} {
+		if err := os.MkdirAll(root, 0700); err != nil {
+			t.Fatal(err)
+		}
+		integrationGit(t, root, "init", "-q")
+	}
+	integrationWrite(t, a, "source.txt", "initial")
+	integrationWrite(t, a, ".gitignore", "*.log\n")
+	original := synchronization.ProtocolHandlers[url.Protocol_Local]
+	counts := &policyCountingHandler{base: original}
+	synchronization.ProtocolHandlers[url.Protocol_Local] = counts
+	t.Cleanup(func() { synchronization.ProtocolHandlers[url.Protocol_Local] = original })
+	manager, err := synchronization.NewManager(logging.NewLogger(logging.LevelError, io.Discard))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(manager.Shutdown)
+	configuration := &synchronization.Configuration{Ignores: []string{synchronization.GitPolicyMarker}, WatchMode: synchronization.WatchMode_WatchModeForcePoll, WatchPollingInterval: 1}
+	id, err := manager.Create(context.Background(), &url.URL{Kind: url.Kind_Synchronization, Protocol: url.Protocol_Local, Path: a}, &url.URL{Kind: url.Kind_Synchronization, Protocol: url.Protocol_Local, Path: b}, configuration, &synchronization.Configuration{}, &synchronization.Configuration{}, "chisa-vps-idle-fixture", nil, false, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	integrationWait(t, manager, id, func() bool { return integrationExists(b, "source.txt") })
+	var latencies []float64
+	save := func(index int) {
+		content := fmt.Sprintf("saved-%d", index)
+		started := time.Now()
+		integrationWrite(t, a, "source.txt", content)
+		integrationWait(t, manager, id, func() bool {
+			data, err := os.ReadFile(filepath.Join(b, "source.txt"))
+			return err == nil && string(data) == content
+		})
+		latencies = append(latencies, float64(time.Since(started).Milliseconds()))
+	}
+	for index := 0; index < 5; index++ {
+		save(index)
+	}
+	startConnections, startCycles := counts.connections.Load(), integrationCycle(t, manager, id)
+	// A real idle boundary, with the autonomous controller and pollers running.
+	// No manual synchronization APIs are called during or after this interval.
+	<-time.After(100 * time.Second)
+	if counts.connections.Load() != startConnections {
+		t.Fatal("idle policy forced endpoint reconnection")
+	}
+	if integrationCycle(t, manager, id) <= startCycles {
+		t.Fatal("idle autonomous controller stopped")
+	}
+	for index := 5; index < 10; index++ {
+		save(index)
+	}
+	integrationWrite(t, a, "future.log", "stay local after idle")
+	if err := os.Rename(filepath.Join(a, "source.txt"), filepath.Join(a, "renamed.txt")); err != nil {
+		t.Fatal(err)
+	}
+	integrationWait(t, manager, id, func() bool { return integrationExists(b, "renamed.txt") && !integrationExists(b, "source.txt") })
+	if err := os.Remove(filepath.Join(a, "renamed.txt")); err != nil {
+		t.Fatal(err)
+	}
+	integrationWait(t, manager, id, func() bool { return !integrationExists(b, "renamed.txt") })
+	if integrationExists(b, "future.log") {
+		t.Fatal("ignored file uploaded after idle")
+	}
+	if counts.connections.Load() != 2 {
+		t.Fatalf("endpoint connections=%d want2", counts.connections.Load())
+	}
+	sort.Float64s(latencies)
+	t.Logf("10 ordinary saves p50=%.0fms p95=%.0fms; connections=%d policyCaptures=%d policyEvaluations=%d scans=%d successfulCycles=%d", latencies[4], latencies[9], counts.connections.Load(), counts.captures.Load(), counts.evaluations.Load(), counts.scans.Load(), integrationCycle(t, manager, id))
+}
