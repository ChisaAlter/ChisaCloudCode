+package local
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+)
+
+func TestGitPolicyWitnessContentAndIncludeChangesWithoutEvents(t *testing.T) {
+	a, b := policyPair(t)
+	global := filepath.Join(filepath.Dir(a.root), "isolated-config")
+	t.Setenv("GIT_CONFIG_GLOBAL", global)
+	t.Setenv("GIT_CONFIG_NOSYSTEM", "1")
+	policyWrite(t, a.root, "ordinary.txt", "file")
+	policyWrite(t, a.root, "src/.gitignore", "alpha.txt\n")
+	policyWrite(t, a.root, "src/beta.txt", "must become ignored")
+	policyScan(t, a, b)
+	original, err := os.Stat(filepath.Join(a.root, "src/.gitignore"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	policyWrite(t, a.root, "src/.gitignore", "beta.txt\n")
+	if err := os.Chtimes(filepath.Join(a.root, "src/.gitignore"), original.ModTime(), original.ModTime()); err != nil {
+		t.Fatal(err)
+	}
+	a.lockScanLock(context.Background())
+	err = a.validateGitPolicy(context.Background())
+	a.unlockScanLock()
+	if err == nil {
+		t.Fatal("same-size/same-time ignored rule edit reused cached policy")
+	}
+	snapshot, _ := policyScan(t, a, b)
+	requirePolicyEntry(t, snapshot, "src/beta.txt", false)
+	// An absent included config is a witness dependency before it exists.
+	included := filepath.Join(filepath.Dir(a.root), "new-include")
+	if err := os.WriteFile(global, []byte("[include]\n path = "+filepath.ToSlash(included)+"\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	policyScan(t, a, b)
+	if err := os.WriteFile(included, []byte("[core]\n excludesFile = "+filepath.ToSlash(filepath.Join(filepath.Dir(a.root), "global-ignore"))+"\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(filepath.Dir(a.root), "global-ignore"), []byte("ordinary.txt\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	snapshot, _ = policyScan(t, a, b)
+	requirePolicyEntry(t, snapshot, "ordinary.txt", false)
+}
+func TestGitPolicyWitnessAdminIdentityAndLocks(t *testing.T) {
+	a, b := policyPair(t)
+	policyWrite(t, a.root, "ordinary.txt", "file")
+	policyScan(t, a, b)
+	original := filepath.Join(a.root, ".git")
+	moved := filepath.Join(a.root, "old-git")
+	if err := os.Rename(original, moved); err != nil {
+		t.Fatal(err)
+	}
+	policyCommand(t, a.root, "init", "-q")
+	a.lockScanLock(context.Background())
+	err := a.validateGitPolicy(context.Background())
+	a.unlockScanLock()
+	if err == nil {
+		t.Fatal("replacement Git directory retained admission")
+	}
+}
+func TestGitPolicyWitnessRejectsOversizePolicyMetadata(t *testing.T) {
+	a, _ := policyPair(t)
+	file, err := os.Create(filepath.Join(a.root, ".gitignore"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := file.Truncate((64 << 20) + 1); err != nil {
+		t.Fatal(err)
+	}
+	file.Close()
+	repository, dirs, err := policyRoot(context.Background(), a.root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := newGitPolicyWitness(context.Background(), a.root, repository, dirs, []string{"ordinary.txt"}); err == nil {
+		t.Fatal("oversize policy input accepted")
+	}
+}
+func TestGitPolicyWitnessCandidateAndOrdinaryEditReuse(t *testing.T) {
+	a, b := policyPair(t)
+	policyWrite(t, a.root, "ordinary.txt", "one")
+	policyScan(t, a, b)
+	previous := a.gitPolicyEvaluation
+	policyWrite(t, a.root, "ordinary.txt", "two")
+	policyScan(t, a, b)
+	if a.gitPolicyEvaluation != previous {
+		t.Fatal("ordinary content edit rebuilt semantic Git matching")
+	}
+	policyWrite(t, a.root, "new.txt", "new")
+	policyScan(t, a, b)
+	if a.gitPolicyEvaluation == previous {
+		t.Fatal("new candidate reused old semantic Git matching")
+	}
+	if _, err := a.GitPolicy(context.Background(), &synchronization.GitPolicyRequest{Operation: "install", Paths: []string{"different"}, Token: a.gitPolicyToken, Admitted: []string{"different"}}); err == nil {
+		t.Fatal("mismatched candidate set installed")
+	}
+}
