+			return nil, err
+		}
+		if response == nil || response.Capability != GitPolicyCapability {
+			return nil, errors.New("policy installation capability mismatch")
+		}
+		installed[index] = response
+	}
+	if !active {
+		*cache = gitPolicyPreparation{}
+		return nil, nil
+	}
+	cache.captures = [2]*GitPolicyResponse{ac, bc}
+	cache.installed = installed
+	cache.ancestor = ancestor
+	cache.ignorer = NewGitPolicyIgnorer(admitted)
+	cache.ready = true
+	return cache.ignorer, nil
