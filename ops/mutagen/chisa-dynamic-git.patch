+package local
+
+import (
+	"context"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/mutagen-io/mutagen/pkg/logging"
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+)
+
+func TestGitPolicyFallbackRootsRetainStaticCoverage(t *testing.T) {
+	for _, mode := range []string{"both-file-only", "selected-subtrees", "mixed"} {
+		t.Run(mode, func(t *testing.T) {
+			private := t.TempDir()
+			t.Setenv("MUTAGEN_DATA_DIRECTORY", filepath.Join(private, "daemon"))
+			t.Setenv("HOME", private)
+			t.Setenv("USERPROFILE", private)
+			t.Setenv("GIT_CONFIG_GLOBAL", filepath.Join(private, "config"))
+			t.Setenv("GIT_CONFIG_NOSYSTEM", "1")
+			var endpoints []*endpoint
+			for index, name := range []string{"alpha", "beta"} {
+				root := filepath.Join(private, name)
+				if err := os.MkdirAll(root, 0700); err != nil {
+					t.Fatal(err)
+				}
+				if mode == "selected-subtrees" {
+					policyCommand(t, root, "init", "-q")
+					root = filepath.Join(root, "selected")
+					if err := os.MkdirAll(root, 0700); err != nil {
+						t.Fatal(err)
+					}
+				}
+				if mode == "mixed" && index == 0 {
+					policyCommand(t, root, "init", "-q")
+					policyWrite(t, root, ".gitignore", "*.log\n")
+				}
+				policyWrite(t, root, "ordinary.txt", "source")
+				policyWrite(t, root, "future.log", "artifact")
+				policyWrite(t, root, "node_modules/pkg/file", "dependency")
+				created, err := NewEndpoint(logging.NewLogger(logging.LevelError, io.Discard), root, "fallback-fixture", synchronization.DefaultVersion, &synchronization.Configuration{Ignores: []string{synchronization.GitPolicyMarker, "node_modules"}, WatchMode: synchronization.WatchMode_WatchModeNoWatch}, index == 0)
+				if err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(func() { created.Shutdown() })
+				endpoints = append(endpoints, created.(*endpoint))
+			}
+			a, b := endpoints[0], endpoints[1]
+			capture, err := b.GitPolicy(context.Background(), &synchronization.GitPolicyRequest{Operation: "capture"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if capture.Repository || len(capture.Paths) != 0 {
+				t.Fatal("file-only capture performed full candidate inventory")
+			}
+			if _, err := synchronization.PrepareGitPolicy(context.Background(), a, b, nil); err != nil {
+				t.Fatal(err)
+			}
+			for _, endpoint := range endpoints {
+				snapshot, err, _ := endpoint.Scan(context.Background(), nil, true)
+				if err != nil {
+					t.Fatal(err)
+				}
+				requirePolicyEntry(t, snapshot, "ordinary.txt", true)
+				requirePolicyEntry(t, snapshot, "future.log", mode != "mixed")
+				requirePolicyEntry(t, snapshot, "node_modules/pkg/file", false)
+				if endpoint.gitPolicyActive != (mode == "mixed") {
+					t.Fatal("fallback dynamic mode differs from repository selection")
+				}
+			}
+		})
+	}
+}
