+		// opens its untracked siblings. Every directory has an explicit key.
+		admitted = gitPolicyPaths(admitted)
+	}
+	var installed [2]*GitPolicyResponse
+	for index, item := range []struct {
+		endpoint GitPolicyEndpoint
+		response *GitPolicyResponse
+	}{{a, ae}, {b, be}} {
+		operation := "install"
+		if !active {
+			operation = "fallback"
+		}
+		response, err := item.endpoint.GitPolicy(ctx, &GitPolicyRequest{Operation: operation, Paths: paths, Token: item.response.Token, Admitted: admitted})
