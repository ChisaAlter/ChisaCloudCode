--- /dev/null
+++ b/pkg/synchronization/endpoint/local/git_policy.go
@@ -0,0 +1,433 @@
+package local
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"sort"
+	"strings"
+	"time"
+
+	"google.golang.org/protobuf/proto"
+
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core/ignore"
+)
+
+// policyContext bounds all background Git work; a stopped or broken Git process
+// cannot hold a file endpoint indefinitely. No user profile or Git environment
+// override may redirect the repository being admitted.
+func policyContext(parent context.Context) (context.Context, context.CancelFunc) {
+	return context.WithTimeout(parent, 15*time.Second)
+}
+func policyGit(ctx context.Context, root string, input []byte, args ...string) ([]byte, error) {
+	ctx, cancel := policyContext(ctx)
+	defer cancel()
+	command := exec.CommandContext(ctx, "git", append([]string{"-C", root, "-c", "core.fsmonitor=false", "-c", "core.hooksPath=", "-c", "core.untrackedCache=false"}, args...)...)
+	for _, value := range os.Environ() {
+		key := strings.ToUpper(strings.SplitN(value, "=", 2)[0])
+		if !strings.HasPrefix(key, "GIT_") || key == "GIT_CONFIG_GLOBAL" || key == "GIT_CONFIG_SYSTEM" || key == "GIT_CONFIG_NOSYSTEM" || key == "GIT_CONFIG_COUNT" || strings.HasPrefix(key, "GIT_CONFIG_KEY_") || strings.HasPrefix(key, "GIT_CONFIG_VALUE_") {
+			command.Env = append(command.Env, value)
+		}
+	}
+	command.Env = append(command.Env, "GIT_OPTIONAL_LOCKS=0", "GIT_TERMINAL_PROMPT=0", "GIT_NO_LAZY_FETCH=1", "LC_ALL=C")
+	command.Stdin = bytes.NewReader(input)
+	var output, diagnostic bytes.Buffer
+	command.Stdout, command.Stderr = &output, &diagnostic
+	err := command.Run()
+	if err != nil {
+		return output.Bytes(), fmt.Errorf("git policy %s: %w: %s", args[0], err, strings.TrimSpace(diagnostic.String()))
+	}
+	return output.Bytes(), nil
+}
+func policyExitCode(err error, code int) bool {
+	var exit *exec.ExitError
+	return errors.As(err, &exit) && exit.ExitCode() == code
+}
+func policyPaths(output []byte) ([]string, error) {
+	unique := make(map[string]bool)
+	for _, value := range bytes.Split(output, []byte{0}) {
+		if len(value) == 0 {
+			continue
+		}
+		name := string(value)
+		if !synchronization.ValidGitPolicyPath(name) {
+			return nil, errors.New("Git returned invalid policy path")
+		}
+		unique[name] = true
+	}
+	result := make([]string, 0, len(unique))
+	for value := range unique {
+		result = append(result, value)
+	}
+	sort.Strings(result)
+	return result, nil
+}
+func policyRoot(ctx context.Context, root string) (bool, []string, error) {
+	// rev-parse from a selected subtree is intentionally not a Git-root policy.
+	output, err := policyGit(ctx, root, nil, "rev-parse", "--show-toplevel")
+	if err != nil {
+		if _, statErr := os.Lstat(filepath.Join(root, ".git")); errors.Is(statErr, fs.ErrNotExist) && strings.Contains(err.Error(), "not a git repository") {
+			return false, nil, nil
+		}
+		return false, nil, err
+	}
+	top := strings.TrimRight(string(output), "\r\n")
+	absolute, err := filepath.Abs(root)
+	if err != nil {
+		return false, nil, err
+	}
+	topInfo, err := os.Stat(top)
+	if err != nil {
+		return false, nil, err
+	}
+	rootInfo, err := os.Stat(absolute)
+	if err != nil {
+		return false, nil, err
+	}
+	repository := os.SameFile(topInfo, rootInfo)
+	output, err = policyGit(ctx, root, nil, "rev-parse", "--absolute-git-dir", "--git-common-dir")
+	if err != nil {
+		return false, nil, err
+	}
+	var directories []string
+	for _, value := range strings.Split(strings.TrimRight(string(output), "\r\n"), "\n") {
+		value = strings.TrimSuffix(value, "\r")
+		if !filepath.IsAbs(value) {
+			value = filepath.Join(root, value)
+		}
+		directories = append(directories, filepath.Clean(value))
+	}
+	if len(directories) != 2 {
+		return false, nil, errors.New("invalid Git administrative directories")
+	}
+	return repository, directories, nil
+}
+func policyNoLocks(directories []string) error {
+	for _, directory := range directories {
+		for _, name := range []string{"index.lock", "config.lock", "config.worktree.lock"} {
+			if _, err := os.Lstat(filepath.Join(directory, name)); err == nil {
+				return synchronization.NewGitPolicyRetry(fmt.Sprintf("Git policy metadata is locked: %s", name))
+			} else if !errors.Is(err, fs.ErrNotExist) {
+				return err
+			}
+		}
+	}
+	return nil
+}
+func policyTracked(ctx context.Context, root string, directories []string) ([]string, error) {
+	if err := policyNoLocks(directories); err != nil {
+		return nil, err
+	}
+	output, err := policyGit(ctx, root, nil, "ls-files", "--cached", "-z")
+	if err != nil {
+		return nil, err
+	}
+	return policyPaths(output)
+}
+func policyCapture(ctx context.Context, root string, inventory bool) (*synchronization.GitPolicyResponse, error) {
+	repository, directories, err := policyRoot(ctx, root)
+	if err != nil {
+		return nil, err
+	}
+	result := &synchronization.GitPolicyResponse{Capability: synchronization.GitPolicyCapability, Repository: repository}
+	if repository {
+		result.Tracked, err = policyTracked(ctx, root, directories)
+		if err != nil {
+			return nil, err
+		}
+		output, err := policyGit(ctx, root, nil, "ls-files", "--cached", "--others", "--exclude-standard", "-z")
+		if err != nil {
+			return nil, err
+		}
+		result.Paths, err = policyPaths(output)
+		if err != nil {
+			return nil, err
+		}
+		if err := policyNoLocks(directories); err != nil {
+			return nil, err
+		}
+		return result, nil
+	}
+	if !inventory {
+		return result, nil
+	}
+	// This inventory is needed only when the peer is a Git root. Fallback
+	// sessions still use the original matcher, including selected subtrees.
+	err = filepath.WalkDir(root, func(name string, entry fs.DirEntry, failure error) error {
+		if failure != nil {
+			if name == root && errors.Is(failure, fs.ErrNotExist) {
+				return nil
+			}
+			return failure
+		}
+		if name == root {
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		default:
+		}
+		relative, err := filepath.Rel(root, name)
+		if err != nil {
+			return err
+		}
+		relative = filepath.ToSlash(relative)
+		if synchronization.GitPolicySecurityExcluded(relative) {
+			if entry.IsDir() {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if entry.IsDir() {
+			relative += "/"
+		}
+		result.Paths = append(result.Paths, relative)
+		return nil
+	})
+	return result, err
+}
+
+// evaluatePolicy asks Git about both directory and leaf candidates in one batch.
+// Its token describes effective decisions and the exact index, rather than
+// trusting timestamps, event delivery, or a list captured at startup.
+func evaluatePolicy(ctx context.Context, root string, paths []string) (*synchronization.GitPolicyResponse, error) {
+	repository, directories, err := policyRoot(ctx, root)
+	if err != nil {
+		return nil, err
+	}
+	result := &synchronization.GitPolicyResponse{Capability: synchronization.GitPolicyCapability, Repository: repository}
+	if repository {
+		result.Tracked, err = policyTracked(ctx, root, directories)
+		if err != nil {
+			return nil, err
+		}
+		if len(paths) > 0 {
+			output, checkErr := policyGit(ctx, root, []byte(strings.Join(paths, "\x00")+"\x00"), "check-ignore", "--no-index", "-z", "--stdin")
+			var exit *exec.ExitError
+			if checkErr != nil && (!errors.As(checkErr, &exit) || exit.ExitCode() != 1) {
+				return nil, checkErr
+			}
+			result.Ignored, err = policyPaths(output)
+			if err != nil {
+				return nil, err
+			}
+		}
+		if err := policyNoLocks(directories); err != nil {
+			return nil, err
+		}
+	}
+	hasher := sha256.New()
+	fmt.Fprintf(hasher, "%t\x00%s\x00", repository, strings.Join(directories, "\x00"))
+	for _, set := range [][]string{paths, result.Tracked, result.Ignored} {
+		fmt.Fprintf(hasher, "%s\x00\xff", strings.Join(set, "\x00"))
+	}
+	result.Token = hex.EncodeToString(hasher.Sum(nil))
+	return result, nil
+}
+
+func (e *endpoint) GitPolicy(ctx context.Context, request *synchronization.GitPolicyRequest) (response *synchronization.GitPolicyResponse, resultErr error) {
+	if !e.gitPolicyEnabled {
+		return nil, errors.New("dynamic Git policy was not negotiated")
+	}
+	if request == nil {
+		return nil, errors.New("nil Git policy request")
+	}
+	for _, set := range [][]string{request.Paths, request.Admitted} {
+		for _, value := range set {
+			if !synchronization.ValidGitPolicyPath(value) {
+				return nil, errors.New("invalid policy request path")
+			}
+		}
+	}
+	if !e.lockScanLock(ctx) {
+		return nil, ctx.Err()
+	}
+	defer e.unlockScanLock()
+	defer func() {
+		if synchronization.IsGitPolicyRetry(resultErr) {
+			e.gitPolicyToken = ""
+			e.gitPolicyWitness = nil
+		}
+	}()
+	switch request.Operation {
+	case "capture":
+		// A successful evaluation already proves repository identity and the
+		// exact tracked index. Reuse only while its complete content witness
+		// is unchanged on BOTH sides of fresh candidate enumeration. New
+		// candidates still force evaluate to discover their nested policies.
+		if previous := e.gitPolicyEvaluation; previous != nil && previous.response.Repository && previous.witness.valid(ctx) == nil {
+			output, err := policyGit(ctx, e.root, nil, "ls-files", "--others", "--exclude-standard", "-z")
+			if err != nil {
+				return nil, err
+			}
+			paths, err := policyPaths(output)
+			if err != nil {
+				return nil, err
+			}
+			if err := previous.witness.valid(ctx); err != nil {
+				return nil, err
+			}
+			captureHash := sha256.New()
+			fmt.Fprintf(captureHash, "%s\x00%s", previous.witness.digest, strings.Join(paths, "\x00"))
+			captureToken := hex.EncodeToString(captureHash.Sum(nil))
+			admissionToken := e.gitPolicyAdmissionToken
+			if request.Token != "" && request.Token == captureToken && e.gitPolicyCaptureToken == captureToken && e.gitPolicyToken == previous.response.Token && e.gitPolicyWitness != nil && e.gitPolicyAdmissionKey != "" {
+				return &synchronization.GitPolicyResponse{Capability: synchronization.GitPolicyCapability, Repository: true, Unchanged: true, CaptureToken: captureToken, Token: e.gitPolicyToken, AdmissionToken: admissionToken}, nil
+			}
+			e.gitPolicyCaptureToken = captureToken
+			// The exact index is already proven by the witness. Git only needs
+			// to enumerate new untracked candidates, avoiding repeated output of
+			// every tracked path. Preserve deleted and force-tracked candidates.
+			paths = append(paths, previous.response.Tracked...)
+			slices.Sort(paths)
+			paths = slices.Compact(paths)
+			return &synchronization.GitPolicyResponse{Capability: synchronization.GitPolicyCapability, Repository: true, Paths: paths, Tracked: append([]string(nil), previous.response.Tracked...), CaptureToken: captureToken, Token: e.gitPolicyToken, AdmissionToken: admissionToken}, nil
+		}
+		return policyCapture(ctx, e.root, false)
+	case "inventory":
+		return policyCapture(ctx, e.root, true)
+	case "evaluate":
+		if previous := e.gitPolicyEvaluation; previous != nil && slices.Equal(previous.paths, request.Paths) && previous.witness.valid(ctx) == nil {
+			return proto.Clone(previous.response).(*synchronization.GitPolicyResponse), nil
+		}
+		repository, directories, err := policyRoot(ctx, e.root)
+		if err != nil {
+			return nil, err
+		}
+		witness, err := newGitPolicyWitness(ctx, e.root, repository, directories, request.Paths)
+		if err != nil {
+			return nil, err
+		}
+		secondRepository, secondDirectories, err := policyRoot(ctx, e.root)
+		if err != nil {
+			return nil, err
+		}
+		second, err := newGitPolicyWitness(ctx, e.root, secondRepository, secondDirectories, request.Paths)
+		if err != nil {
+			return nil, err
+		}
+		if repository != secondRepository || !slices.Equal(directories, secondDirectories) {
+			return nil, errors.New("Git repository identity changed during discovery")
+		}
+		if !slices.Equal(witness.files, second.files) || witness.digest != second.digest {
+			return nil, synchronization.NewGitPolicyRetry("Git policy dependencies changed during discovery")
+		}
+		if err := witness.valid(ctx); err != nil {
+			return nil, err
+		}
+		response, err := evaluatePolicy(ctx, e.root, request.Paths)
+		if err != nil {
+			return nil, err
+		}
+		if err := witness.valid(ctx); err != nil {
+			return nil, err
+		}
+		if err := second.valid(ctx); err != nil {
+			return nil, err
+		}
+		// Bind the answer to the complete content witness, not to event stamps.
+		response.Token = witness.digest
+		e.gitPolicyEvaluation = &gitPolicyEvaluation{append([]string(nil), request.Paths...), response, witness}
+		return proto.Clone(response).(*synchronization.GitPolicyResponse), nil
+	case "install", "fallback":
+		evaluation := e.gitPolicyEvaluation
+		if evaluation == nil || request.Token == "" || evaluation.response.Token != request.Token || !slices.Equal(evaluation.paths, request.Paths) {
+			return nil, errors.New("Git policy was not evaluated for admission")
+		}
+		if err := evaluation.witness.valid(ctx); err != nil {
+			return nil, err
+		}
+		current := evaluation.response
+		var next ignore.Ignorer = e.staticIgnorer
+		active := request.Operation == "install"
+		if active {
+			next = synchronization.NewGitPolicyIgnorer(request.Admitted)
+		}
+		// Policy coverage may change without a file event (index/ignore files).
+		// Preserve digest cache, discard only stale coverage/scan acceleration.
+		admissionKey := request.Operation + "\x00" + strings.Join(request.Admitted, "\x00")
+		if admissionKey != e.gitPolicyAdmissionKey {
+			e.snapshot = nil
+			e.ignoreCache = nil
+			e.accelerate = false
+			e.recheckPaths = nil
+		}
+		e.ignorer, e.gitPolicyActive, e.gitPolicyAdmissionKey = next, active, admissionKey
+		e.gitPolicyPaths, e.gitPolicyToken = append([]string(nil), request.Paths...), request.Token
+		e.gitPolicyWitness = evaluation.witness
+		admissionHash := sha256.Sum256([]byte(admissionKey))
+		e.gitPolicyAdmissionToken = hex.EncodeToString(admissionHash[:])
+		ack := proto.Clone(current).(*synchronization.GitPolicyResponse)
+		ack.AdmissionToken = e.gitPolicyAdmissionToken
+		return ack, nil
+	case "validate":
+		if err := e.validateGitPolicy(ctx); err != nil {
+			return nil, err
+		}
+		return &synchronization.GitPolicyResponse{Capability: synchronization.GitPolicyCapability}, nil
+	default:
+		return nil, errors.New("unknown Git policy operation")
+	}
+}
+
+// Caller holds scanLock. Nothing authorizes a stale or incomplete policy.
+func (e *endpoint) validateGitPolicy(ctx context.Context) error {
+	if !e.gitPolicyEnabled {
+		return nil
+	}
+	if e.gitPolicyToken == "" {
+		return errors.New("Git policy has not been admitted")
+	}
+	if e.gitPolicyWitness == nil {
+		return errors.New("Git policy witness missing")
+	}
+	return e.gitPolicyWitness.valid(ctx)
+}
+func (e *endpoint) admitGitPolicyChange(value string, entry *core.Entry) error {
+	if entry == nil {
+		return nil
+	}
+	if value != "" {
+		if status, _ := e.ignorer.Ignore(value, entry.Kind == core.EntryKind_Directory); status == ignore.IgnoreStatusIgnored {
+			return fmt.Errorf("transition outside admitted Git policy: %s", value)
+		}
+	}
+	for name, child := range entry.Contents {
+		prefix := name
+		if value != "" {
+			prefix = value + "/" + name
+		}
+		if err := e.admitGitPolicyChange(prefix, child); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+func (e *endpoint) admitGitPolicyPaths(ctx context.Context, paths []string, directory bool) error {
+	if !e.gitPolicyEnabled {
+		return nil
+	}
+	if err := e.validateGitPolicy(ctx); err != nil {
+		return err
+	}
+	if !e.gitPolicyActive {
+		return nil
+	}
+	for _, value := range paths {
+		if status, _ := e.ignorer.Ignore(value, directory); status == ignore.IgnoreStatusIgnored {
+			return fmt.Errorf("path not admitted by current Git policy: %s", value)
+		}
+	}
+	return nil
+}
