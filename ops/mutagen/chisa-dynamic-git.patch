+package synchronization
+
+import (
+	"context"
+	"io"
+	"path/filepath"
+	"testing"
+
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	"github.com/mutagen-io/mutagen/pkg/encoding"
+	"github.com/mutagen-io/mutagen/pkg/identifier"
+	"github.com/mutagen-io/mutagen/pkg/logging"
+	"github.com/mutagen-io/mutagen/pkg/state"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	"github.com/mutagen-io/mutagen/pkg/url"
+)
+
+func TestGitPolicyLegacySessionLoadPersistsPauseBeforeConnections(t *testing.T) {
+	private := t.TempDir()
+	t.Setenv("MUTAGEN_DATA_DIRECTORY", filepath.Join(private, "daemon"))
+	id, err := identifier.New(identifier.PrefixSynchronization)
+	if err != nil {
+		t.Fatal(err)
+	}
+	session := &Session{Identifier: id, Version: DefaultVersion, CreationTime: timestamppb.Now(), Alpha: &url.URL{Kind: url.Kind_Synchronization, Protocol: url.Protocol_Local, Path: filepath.Join(private, "alpha")}, Beta: &url.URL{Kind: url.Kind_Synchronization, Protocol: url.Protocol_Local, Path: filepath.Join(private, "beta")}, Configuration: &Configuration{Ignores: []string{"legacy-literal"}}, ConfigurationAlpha: &Configuration{}, ConfigurationBeta: &Configuration{}, Name: "chisa-vps-legacy", Paused: false}
+	path, err := pathForSession(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := encoding.MarshalAndSaveProtobuf(path, session); err != nil {
+		t.Fatal(err)
+	}
+	archive, err := pathForArchive(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := encoding.MarshalAndSaveProtobuf(archive, &core.Archive{}); err != nil {
+		t.Fatal(err)
+	}
+	tracker := state.NewTracker()
+	loaded, err := loadSession(logging.NewLogger(logging.LevelError, io.Discard), tracker, id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !loaded.session.Paused || loaded.cancel != nil {
+		t.Fatal("legacy session started a connection before policy migration")
+	}
+	persisted := &Session{}
+	if err := encoding.LoadAndUnmarshalProtobuf(path, persisted); err != nil {
+		t.Fatal(err)
+	}
+	if !persisted.Paused {
+		t.Fatal("legacy pause not persisted")
+	}
+	if err := loaded.resume(context.Background(), "", false); err == nil {
+		t.Fatal("legacy policy resumed without marker")
+	}
+	manager := &Manager{sessionsLock: state.NewTrackingLock(tracker), sessions: map[string]*controller{id: loaded}}
+	if err := manager.UpdateIgnores(context.Background(), id, &Configuration{Ignores: []string{GitPolicyMarker}}); err != nil {
+		t.Fatal(err)
+	}
+	if !loaded.session.Configuration.DynamicGitPolicy() || !loaded.session.Paused || loaded.cancel != nil {
+		t.Fatal("policy migration connected or lost pause/marker")
+	}
+}
+func TestGitPolicyCreateRequiresMarkerBeforeConnecting(t *testing.T) {
+	_, err := newSession(context.Background(), logging.NewLogger(logging.LevelError, io.Discard), state.NewTracker(), "unused", nil, nil, &Configuration{}, &Configuration{}, &Configuration{}, "chisa-vps-new", nil, false, "")
+	if err == nil {
+		t.Fatal("Chisa create accepted literal policy before connection")
+	}
+}
