diff --git a/pkg/synchronization/git_policy.go b/pkg/synchronization/git_policy.go
new file mode 100644
--- /dev/null
+++ b/pkg/synchronization/git_policy.go
@@ -0,0 +1,345 @@
+package synchronization
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"path"
+	"sort"
+	"strings"
+
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core/ignore"
+)
+
+// GitPolicyMarker opts a Chisa session into the versioned, two-endpoint policy
+// exchange. Older engines must be rejected by the caller's exact version check.
+const GitPolicyMarker = "/.chisa-sync-policy/git-v1"
+const GitPolicyCapability = "chisa-git-policy-v1"
+
+// GitPolicyRetryError describes a coherent protocol exchange whose policy
+// evidence changed before any transfer began. It never authorizes reuse of a
+// scan or admission set; the controller must restart joint admission.
+// Transport, identity, malformed configuration and filesystem I/O errors do not
+// use this type and retain normal endpoint failure handling.
+type GitPolicyRetryError struct{ Reason string }
+
+func (e *GitPolicyRetryError) Error() string { return e.Reason }
+func NewGitPolicyRetry(reason string) error  { return &GitPolicyRetryError{Reason: reason} }
+func IsGitPolicyRetry(err error) bool        { var retry *GitPolicyRetryError; return errors.As(err, &retry) }
+
+// GitPolicyEndpoint is deliberately separate from Endpoint: ordinary upstream
+// endpoints retain their interface, but an opted-in session requires this
+// capability on BOTH endpoints before any scan or transfer.
+type GitPolicyEndpoint interface {
+	GitPolicy(context.Context, *GitPolicyRequest) (*GitPolicyResponse, error)
+}
+
+func (c *Configuration) DynamicGitPolicy() bool {
+	for _, patterns := range [][]string{c.DefaultIgnores, c.Ignores} {
+		for _, pattern := range patterns {
+			if pattern == GitPolicyMarker {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func ValidGitPolicyPath(value string) bool {
+	value = strings.TrimSuffix(value, "/")
+	return value != "" && value != "." && value != ".." && !strings.HasPrefix(value, "../") && !strings.HasPrefix(value, "/") && !strings.ContainsAny(value, "\x00\\") && path.Clean(value) == value
+}
+
+func gitPolicyPaths(sets ...[]string) []string {
+	unique := make(map[string]bool)
+	for _, set := range sets {
+		for _, value := range set {
+			unique[value] = true
+			for parent := path.Dir(strings.TrimSuffix(value, "/")); parent != "." && parent != "/"; parent = path.Dir(parent) {
+				unique[parent+"/"] = true
+			}
+		}
+	}
+	result := make([]string, 0, len(unique))
+	for value := range unique {
+		result = append(result, value)
+	}
+	sort.Strings(result)
+	return result
+}
+
+func gitPolicyArchivePaths(entry *core.Entry) []string {
+	var result []string
+	var visit func(string, *core.Entry)
+	visit = func(prefix string, entry *core.Entry) {
+		if entry == nil {
+			return
+		}
+		if prefix != "" {
+			value := prefix
+			if entry.Kind == core.EntryKind_Directory {
+				value += "/"
+			}
+			result = append(result, value)
+		}
+		for name, child := range entry.Contents {
+			value := name
+			if prefix != "" {
+				value = prefix + "/" + name
+			}
+			visit(value, child)
+		}
+	}
+	visit("", entry)
+	return result
+}
+
+// GitPolicySecurityExcluded is independent of both Git indexes and user rules.
+// A force-add never publishes credentials, VCS internals or runtime dependencies.
+func GitPolicySecurityExcluded(value string) bool {
+	parts := strings.Split(strings.TrimSuffix(value, "/"), "/")
+	for _, part := range parts {
+		switch part {
+		case "node_modules", ".git", ".svn", ".hg", ".bzr", "_darcs", ".venv", "venv", "__pycache__", ".chisa-bridge.json", ".chisa-session.json", ".chisa-lease", ".chisa-worktrees", ".chisa-sync-policy":
+			return true
+		}
+		if part == ".env" || strings.HasPrefix(part, ".env.") && part != ".env.example" && part != ".env.sample" {
+			return true
+		}
+	}
+	return false
+}
+
+func gitPolicyGenerated(value string) bool {
+	first := strings.SplitN(value, "/", 2)[0]
+	switch first {
+	case "dist", "build", "out", ".next", "coverage", ".cache", "cache", ".tmp", ".dev", ".nodetmp":
+		return true
+	}
+	return false
+}
+
+type gitPolicyIgnorer struct{ admitted map[string]bool }
+
+func NewGitPolicyIgnorer(admitted []string) ignore.Ignorer {
+	values := make(map[string]bool, len(admitted))
+	for _, value := range admitted {
+		values[value] = true
+	}
+	return &gitPolicyIgnorer{values}
+}
+func (i *gitPolicyIgnorer) Ignore(value string, directory bool) (ignore.IgnoreStatus, bool) {
+	key := value
+	if directory {
+		key += "/"
+	}
+	if !GitPolicySecurityExcluded(value) && i.admitted[key] {
+		return ignore.IgnoreStatusUnignored, false
+	}
+	return ignore.IgnoreStatusIgnored, false
+}
+
+// PrepareGitPolicy captures both roots, evaluates the complete union under both
+// Git policies, then installs one immutable admission set on both endpoints.
+// Archive paths remain candidates even when absent, preserving real deletions.
+func PrepareGitPolicy(ctx context.Context, alpha, beta Endpoint, ancestor *core.Entry) (ignore.Ignorer, error) {
+	return (&gitPolicyPreparation{}).prepare(ctx, alpha, beta, ancestor)
+}
+
+// One controller owns this cache. Entries are immutable and usable only after
+// both fresh captures prove the exact installed generation and candidate set.
+type gitPolicyPreparation struct {
+	captures  [2]*GitPolicyResponse
+	installed [2]*GitPolicyResponse
+	ancestor  *core.Entry
+	ignorer   ignore.Ignorer
+	ready     bool
+}
+
+// sameGitPolicyArchiveShape compares only the archive information used to form
+// policy candidates: every path and exact entry kind. Content-only changes do
+// not alter that candidate set. The immutable pointer fast path avoids walking
+// unchanged subtrees; a rename, addition, removal or kind change requires fresh
+// joint evaluation. Policy evidence is still captured and verified separately.
+func sameGitPolicyArchiveShape(previous, current *core.Entry) bool {
+	if previous == current {
+		return true
+	}
+	if previous == nil || current == nil || previous.Kind != current.Kind || len(previous.Contents) != len(current.Contents) {
+		return false
+	}
+	for name, child := range previous.Contents {
+		other, present := current.Contents[name]
+		if !present || !sameGitPolicyArchiveShape(child, other) {
+			return false
+		}
+	}
+	return true
+}
+
+func (cache *gitPolicyPreparation) prepare(ctx context.Context, alpha, beta Endpoint, ancestor *core.Entry) (result ignore.Ignorer, resultErr error) {
+	defer func() {
+		if resultErr != nil {
+			*cache = gitPolicyPreparation{}
+		}
+	}()
+	a, ok := alpha.(GitPolicyEndpoint)
+	if !ok {
+		return nil, errors.New("alpha lacks dynamic Git policy capability")
+	}
+	b, ok := beta.(GitPolicyEndpoint)
+	if !ok {
+		return nil, errors.New("beta lacks dynamic Git policy capability")
+	}
+	capture := func(endpoint GitPolicyEndpoint, operation string, paths []string) (*GitPolicyResponse, error) {
+		response, err := endpoint.GitPolicy(ctx, &GitPolicyRequest{Operation: operation, Paths: paths})
+		if err != nil {
+			return nil, err
+		}
+		if response == nil || response.Capability != GitPolicyCapability {
+			return nil, errors.New("dynamic Git policy capability mismatch")
+		}
+		for _, set := range [][]string{response.Paths, response.Tracked, response.Ignored} {
+			for _, value := range set {
+				if !ValidGitPolicyPath(value) {
+					return nil, errors.New("invalid dynamic Git policy path")
+				}
+			}
+		}
+		return response, nil
+	}
+	canReuse := cache.ready && sameGitPolicyArchiveShape(cache.ancestor, ancestor)
+	captureCurrent := func(endpoint GitPolicyEndpoint, index int) (*GitPolicyResponse, error) {
+		request := &GitPolicyRequest{Operation: "capture"}
+		if canReuse && cache.captures[index] != nil {
+			request.Token = cache.captures[index].CaptureToken
+		}
+		response, err := endpoint.GitPolicy(ctx, request)
+		if err != nil {
+			return nil, err
+		}
+		if response == nil || response.Capability != GitPolicyCapability {
+			return nil, errors.New("capture capability mismatch")
+		}
+		if response.Unchanged {
+			previous, installed := cache.captures[index], cache.installed[index]
+			if !canReuse || previous == nil || installed == nil || request.Token == "" || response.CaptureToken != request.Token || response.Token != installed.Token || response.AdmissionToken == "" || response.AdmissionToken != installed.AdmissionToken || !response.Repository {
+				return nil, NewGitPolicyRetry("installed Git policy generation changed")
+			}
+		} else {
+			for _, set := range [][]string{response.Paths, response.Tracked} {
+				for _, value := range set {
+					if !ValidGitPolicyPath(value) {
+						return nil, errors.New("invalid capture path")
+					}
+				}
+			}
+		}
+		return response, nil
+	}
+	ac, err := captureCurrent(a, 0)
+	if err != nil {
+		return nil, fmt.Errorf("alpha policy capture: %w", err)
+	}
+	bc, err := captureCurrent(b, 1)
+	if err != nil {
+		return nil, fmt.Errorf("beta policy capture: %w", err)
+	}
+	if ac.Unchanged && bc.Unchanged {
+		for _, endpoint := range []GitPolicyEndpoint{a, b} {
+			if _, err := capture(endpoint, "validate", nil); err != nil {
+				return nil, err
+			}
+		}
+		// Keep the current content tree, never a projected tree or an older
+		// digest. The controller projects this attempt's current ancestor.
+		cache.ancestor = ancestor
+		return cache.ignorer, nil
+	}
+	// One changed side invalidates joint reuse. Resolve an unchanged side from
+	// the immutable full capture that its current proof just confirmed.
+	if ac.Unchanged {
+		ac = cache.captures[0]
+	}
+	if bc.Unchanged {
+		bc = cache.captures[1]
+	}
+	// File-only roots and selected subtrees retain their ordinary scan path:
+	// do not inventory an entire tree merely to discover both policies inactive.
+	// A file-only peer of an actual Git root still contributes its candidates.
+	if ac.Repository != bc.Repository {
+		if !ac.Repository {
+			ac, err = capture(a, "inventory", nil)
+		} else {
+			bc, err = capture(b, "inventory", nil)
+		}
+		if err != nil {
+			return nil, err
+		}
+	}
+	paths := gitPolicyPaths(ac.Paths, bc.Paths, ac.Tracked, bc.Tracked, gitPolicyArchivePaths(ancestor))
+	ae, err := capture(a, "evaluate", paths)
+	if err != nil {
+		return nil, fmt.Errorf("alpha policy evaluation: %w", err)
+	}
+	be, err := capture(b, "evaluate", paths)
+	if err != nil {
+		return nil, fmt.Errorf("beta policy evaluation: %w", err)
+	}
+	tracked := make(map[string]bool)
+	for _, set := range [][]string{ae.Tracked, be.Tracked} {
+		for _, value := range set {
+			tracked[value] = true
+			for parent := path.Dir(value); parent != "." && parent != "/"; parent = path.Dir(parent) {
+				tracked[parent+"/"] = true
+			}
+		}
+	}
+	ignored := make(map[string]bool)
+	for _, set := range [][]string{ae.Ignored, be.Ignored} {
+		for _, value := range set {
+			ignored[value] = true
+		}
+	}
+	var admitted []string
+	active := ae.Repository || be.Repository
+	if active {
+		for _, value := range paths {
+			if !GitPolicySecurityExcluded(value) && (tracked[value] || !ignored[value] && !gitPolicyGenerated(value)) {
