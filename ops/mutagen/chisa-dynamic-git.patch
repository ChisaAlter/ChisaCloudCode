--- /dev/null
+++ b/cmd/mutagen-agent/stream_synchronization_linux_test.go
@@ -0,0 +1,358 @@
+//go:build linux
+
+package main
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+
+	"github.com/mutagen-io/mutagen/pkg/agent"
+	"github.com/mutagen-io/mutagen/pkg/encoding"
+	"github.com/mutagen-io/mutagen/pkg/mutagen"
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/compression"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/endpoint/remote"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/rsync"
+)
+
+// TestSynchronizationStdioHelperProcess runs the actual synchronizer entry point
+// when no standalone agent binary is supplied. It must never print test-runner
+// output on stdout, which carries the protocol.
+func TestSynchronizationStdioHelperProcess(t *testing.T) {
+	if os.Getenv("MUTAGEN_STDIO_TEST_CHILD") != "1" {
+		return
+	}
+	synchronizerConfiguration.logLevel = "error"
+	if err := synchronizerMain(nil, nil); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	os.Exit(0)
+}
+
+type synchronizationAgentProcess struct {
+	command      *exec.Cmd
+	input        *os.File
+	output       *os.File
+	fill         *os.File
+	fillFD       int
+	pipeCapacity int
+	root         string
+	stderr       bytes.Buffer
+	done         chan struct{}
+	waitErr      error
+	stopOnce     sync.Once
+}
+
+func startSynchronizationAgent(t *testing.T) *synchronizationAgentProcess {
+	t.Helper()
+	inputRead, inputWrite, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	outputRead, outputWrite, err := os.Pipe()
+	if err != nil {
+		inputRead.Close()
+		inputWrite.Close()
+		t.Fatal(err)
+	}
+	// Save the descriptor before Start. Calling File.Fd afterward can restore
+	// blocking mode on the open-file description shared with the child.
+	fillFD := int(outputWrite.Fd())
+	capacity, err := unix.FcntlInt(uintptr(fillFD), unix.F_GETPIPE_SZ, 0)
+	if err != nil {
+		inputRead.Close()
+		inputWrite.Close()
+		outputRead.Close()
+		outputWrite.Close()
+		t.Fatal("unable to determine real stdout pipe capacity:", err)
+	}
+	var command *exec.Cmd
+	if binary := os.Getenv("MUTAGEN_TEST_AGENT_BINARY"); binary != "" {
+		command = exec.Command(binary, "synchronizer", "--log-level", "error")
+	} else {
+		binary, err := os.Executable()
+		if err != nil {
+			inputRead.Close()
+			inputWrite.Close()
+			outputRead.Close()
+			outputWrite.Close()
+			t.Fatal(err)
+		}
+		command = exec.Command(binary, "-test.run=^TestSynchronizationStdioHelperProcess$")
+	}
+	p := &synchronizationAgentProcess{
+		command: command, input: inputWrite, output: outputRead,
+		fill: outputWrite, fillFD: fillFD, pipeCapacity: capacity,
+		root: t.TempDir(), done: make(chan struct{}),
+	}
+	command.Stdin, command.Stdout, command.Stderr = inputRead, outputWrite, &p.stderr
+	command.Env = append(os.Environ(),
+		"MUTAGEN_STDIO_TEST_CHILD=1", "MUTAGEN_DATA_DIRECTORY="+t.TempDir())
+	if err := command.Start(); err != nil {
+		inputRead.Close()
+		p.input.Close()
+		p.output.Close()
+		p.fill.Close()
+		t.Fatal("unable to start synchronization agent:", err)
+	}
+	inputRead.Close()
+	go func() {
+		p.waitErr = command.Wait()
+		close(p.done)
+	}()
+	t.Cleanup(func() { p.stop(t) })
+	return p
+}
+
+func (p *synchronizationAgentProcess) Read(buffer []byte) (int, error) {
+	return p.output.Read(buffer)
+}
+
+func (p *synchronizationAgentProcess) Write(buffer []byte) (int, error) {
+	return p.input.Write(buffer)
+}
+
+func (p *synchronizationAgentProcess) Close() error {
+	return errors.Join(p.input.Close(), p.output.Close())
+}
+
+func (p *synchronizationAgentProcess) stop(t *testing.T) {
+	t.Helper()
+	p.stopOnce.Do(func() {
+		p.input.Close()
+		p.output.Close()
+		p.fill.Close()
+		select {
+		case <-p.done:
+		default:
+			p.command.Process.Kill()
+		}
+		select {
+		case <-p.done:
+		case <-time.After(3 * time.Second):
+			t.Error("synchronization agent did not stop after explicit cleanup")
+		}
+	})
+}
+
+func (p *synchronizationAgentProcess) exchange(t *testing.T, operation func() error) {
+	t.Helper()
+	result := make(chan error, 1)
+	go func() { result <- operation() }()
+	select {
+	case err := <-result:
+		if err != nil {
+			p.stop(t)
+			t.Fatalf("agent protocol exchange failed: %v; stderr: %s", err, p.stderr.String())
+		}
+	case <-time.After(3 * time.Second):
+		p.stop(t)
+		t.Fatal("agent protocol exchange stalled; stderr:", p.stderr.String())
+	}
+}
+
+func (p *synchronizationAgentProcess) expectFailureExit(t *testing.T, cause string) {
+	t.Helper()
+	select {
+	case <-p.done:
+	case <-time.After(3 * time.Second):
+		p.stop(t)
+		t.Fatal("agent remained stuck with the opposite stdio half open; stderr:", p.stderr.String())
+	}
+	var exitError *exec.ExitError
+	if !errors.As(p.waitErr, &exitError) {
+		t.Fatal("expected an ordinary error exit from the agent:", p.waitErr)
+	}
+	status, ok := exitError.Sys().(syscall.WaitStatus)
+	if !ok || status.Signaled() || exitError.ExitCode() != 1 {
+		t.Fatalf("agent did not return normally with its protocol error: %v; stderr: %s", p.waitErr, p.stderr.String())
+	}
+	if !strings.Contains(p.stderr.String(), cause) {
+		t.Fatalf("agent lost the initiating %q error: %s", cause, p.stderr.String())
+	}
+	// The test deliberately leaves stdin open: process exit cannot depend on
+	// the parent closing this writer to release a pending completion read.
+	if _, err := p.input.Stat(); err != nil {
+		t.Fatal("fixture closed stdin before agent termination:", err)
+	}
+}
+
+func initializeRawSynchronizationAgent(t *testing.T, p *synchronizationAgentProcess) *encoding.ProtobufEncoder {
+	t.Helper()
+	encoder := encoding.NewProtobufEncoder(p)
+	decoder := encoding.NewProtobufDecoder(bufio.NewReader(p))
+	p.exchange(t, func() error {
+		if err := agent.ClientHandshake(p); err != nil {
+			return err
+		}
+		if err := mutagen.ClientVersionHandshake(p); err != nil {
+			return err
+		}
+		if err := compression.ClientHandshake(p, compression.Algorithm_AlgorithmNone); err != nil {
+			return err
+		}
+		request := &remote.InitializeSynchronizationRequest{
+			Session: "stdio-protocol", Version: synchronization.DefaultVersion,
+			Root: p.root, Configuration: &synchronization.Configuration{
+				WatchMode:            synchronization.WatchMode_WatchModeNoWatch,
+				CompressionAlgorithm: compression.Algorithm_AlgorithmNone,
+			},
+		}
+		if err := encoder.Encode(request); err != nil {
+			return err
+		}
+		response := &remote.InitializeSynchronizationResponse{}
+		if err := decoder.Decode(response); err != nil {
+			return err
+		}
+		if response.Error != "" {
+			return errors.New(response.Error)
+		}
+		return nil
+	})
+	return encoder
+}
+
+func synchronizationStdioRequest(method string) *remote.EndpointRequest {
+	switch method {
+	case "Poll":
+		return &remote.EndpointRequest{Poll: &remote.PollRequest{}}
+	case "Scan":
+		return &remote.EndpointRequest{Scan: &remote.ScanRequest{
+			BaselineSnapshotSignature: rsync.NewEngine().BytesSignature(nil, 0), Full: true,
+		}}
+	default:
+		panic("unknown synchronization request")
+	}
+}
+
+func TestSynchronizationStdioMalformedCompletion(t *testing.T) {
+	p := startSynchronizationAgent(t)
+	encoder := initializeRawSynchronizationAgent(t, p)
+	// Initialization has consumed all stdout bytes. Fill the empty real pipe
+	// exactly once, without calling Fd after the child changed its shared
+	// open-file description to non-blocking mode.
+	n, err := unix.Write(p.fillFD, make([]byte, p.pipeCapacity))
+	if err != nil || n != p.pipeCapacity {
+		t.Fatalf("could not fill stdout pipe: wrote %d/%d bytes: %v", n, p.pipeCapacity, err)
+	}
+	p.exchange(t, func() error {
+		if err := encoder.Encode(synchronizationStdioRequest("Poll")); err != nil {
+			return err
+		}
+		// A length-one protobuf containing an invalid tag is a decoder error,
+		// not EOF. Keep stdin open and stdout completely full.
+		_, err := p.input.Write([]byte{1, 0xff})
+		return err
+	})
+	p.expectFailureExit(t, "unable to receive completion request")
+	t.Logf("real Poll agent aborted malformed completion with stdout blocked at %d bytes and stdin still open", p.pipeCapacity)
+}
+
+func TestSynchronizationStdioBrokenOutput(t *testing.T) {
+	p := startSynchronizationAgent(t)
+	encoder := initializeRawSynchronizationAgent(t, p)
+	if err := p.output.Close(); err != nil {
+		t.Fatal(err)
+	}
+	p.exchange(t, func() error { return encoder.Encode(synchronizationStdioRequest("Scan")) })
+	p.expectFailureExit(t, "unable to transmit response")
+	if !strings.Contains(p.stderr.String(), "broken pipe") {
+		t.Fatal("agent did not report the real stdout EPIPE:", p.stderr.String())
+	}
+	t.Log("real Scan agent returned EPIPE without SIGPIPE while stdin remained open")
+}
+
+func TestSynchronizationStdioHealthy(t *testing.T) {
+	for _, algorithm := range []compression.Algorithm{
+		compression.Algorithm_AlgorithmNone,
+		compression.Algorithm_AlgorithmDeflate,
+	} {
+		t.Run(algorithm.String(), func(t *testing.T) {
+			p := startSynchronizationAgent(t)
+			p.fill.Close()
+			var endpoint synchronization.Endpoint
+			p.exchange(t, func() error {
+				if err := agent.ClientHandshake(p); err != nil {
+					return err
+				}
+				if err := mutagen.ClientVersionHandshake(p); err != nil {
+					return err
+				}
+				var err error
+				endpoint, err = remote.NewEndpoint(nil, p, p.root, "stdio-healthy",
+					synchronization.DefaultVersion, &synchronization.Configuration{
+						WatchMode:            synchronization.WatchMode_WatchModeNoWatch,
+						CompressionAlgorithm: algorithm,
+					}, false)
+				return err
+			})
+			p.exchange(t, func() error {
+				ctx, cancel := context.WithCancel(context.Background())
+				cancel()
+				if err := endpoint.Poll(ctx); err != nil {
+					return err
+				}
+				if _, err, _ := endpoint.Scan(context.Background(), nil, true); err != nil {
+					return err
+				}
+				changes := []*core.Change{{Path: "ack-proof", New: &core.Entry{Kind: core.EntryKind_Directory}}}
+				results, problems, missing, err := endpoint.Transition(context.Background(), changes)
+				if err != nil || len(results) != 1 || len(problems) != 0 || missing {
+					return fmt.Errorf("directory transition failed: results=%v problems=%v missing=%v err=%v", results, problems, missing, err)
+				}
+				snapshot, err, _ := endpoint.Scan(context.Background(), nil, true)
+				if err != nil || snapshot == nil || snapshot.Content == nil || snapshot.Content.Contents["ack-proof"] == nil {
+					return fmt.Errorf("directory missing from subsequent Scan: %v", err)
+				}
+				return nil
+			})
+			if info, err := os.Stat(filepath.Join(p.root, "ack-proof")); err != nil || !info.IsDir() {
+				t.Fatal("real agent Transition did not create a directory:", err)
+			}
+			select {
+			case <-p.done:
+				t.Fatal("healthy cancellation or ACK terminated the agent:", p.stderr.String())
+			default:
+			}
+			p.exchange(t, endpoint.Shutdown)
+			// Shutdown intentionally closes stdin, so this exit assertion does
+			// not use expectFailureExit, which checks that stdin stayed open.
+			select {
+			case <-p.done:
+			case <-time.After(3 * time.Second):
+				p.stop(t)
+				t.Fatal("healthy agent did not exit after endpoint Shutdown")
+			}
+			var exitError *exec.ExitError
+			if !errors.As(p.waitErr, &exitError) {
+				t.Fatal("agent did not report ordinary protocol termination:", p.waitErr)
+			}
+			if status, ok := exitError.Sys().(syscall.WaitStatus); !ok || status.Signaled() || exitError.ExitCode() != 1 {
+				t.Fatalf("healthy Shutdown killed the agent instead of returning: %v; stderr: %s", p.waitErr, p.stderr.String())
+			}
+			if !strings.Contains(p.stderr.String(), "synchronization terminated") {
+				t.Fatal("missing ordinary synchronization termination:", p.stderr.String())
+			}
+			t.Log("real agent kept one connection for Poll cancel, Scan, directory Transition, Scan, then exited after Shutdown")
+		})
+	}
+}
+
+var _ io.ReadWriteCloser = (*synchronizationAgentProcess)(nil)
