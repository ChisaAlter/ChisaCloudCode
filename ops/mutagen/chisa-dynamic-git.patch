--- /dev/null
+++ b/pkg/synchronization/git_policy_cache_test.go
@@ -0,0 +1,251 @@
+package synchronization
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core/ignore"
+	"google.golang.org/protobuf/proto"
+)
+
+type cacheTestEndpoint struct {
+	Endpoint
+	captureToken, installedToken, admissionToken    string
+	paths                                           []string
+	full, small, evaluations, installs, validations int
+	failInstall                                     bool
+	failValidate                                    bool
+}
+
+func (e *cacheTestEndpoint) GitPolicy(_ context.Context, q *GitPolicyRequest) (*GitPolicyResponse, error) {
+	response := &GitPolicyResponse{Capability: GitPolicyCapability, Repository: true}
+	switch q.Operation {
+	case "capture":
+		response.CaptureToken = e.captureToken
+		response.Token = e.installedToken
+		response.AdmissionToken = e.admissionToken
+		if q.Token != "" && q.Token == e.captureToken {
+			response.Unchanged = true
+			e.small++
+		} else {
+			response.Paths = append([]string(nil), e.paths...)
+			response.Tracked = append([]string(nil), e.paths...)
+			e.full++
+		}
+	case "evaluate":
+		e.evaluations++
+		response.Token = e.captureToken
+		response.Tracked = append([]string(nil), e.paths...)
+	case "install":
+		if e.failInstall {
+			e.failInstall = false
+			return nil, NewGitPolicyRetry("index changed during install")
+		}
+		e.installs++
+		e.installedToken = q.Token
+		e.admissionToken = "joint:" + q.Token
+		response.Token = e.installedToken
+		response.AdmissionToken = e.admissionToken
+	case "validate":
+		e.validations++
+		if e.failValidate {
+			e.failValidate = false
+			return nil, NewGitPolicyRetry("policy changed during validation")
+		}
+	default:
+		return nil, errors.New("unexpected cache test operation")
+	}
+	return response, nil
+}
+func TestGitPolicyArchiveShapeContentChangesKeepCurrentProjection(t *testing.T) {
+	ctx := context.Background()
+	paths := []string{"source.txt", "link"}
+	a, b := &cacheTestEndpoint{captureToken: "a", paths: paths}, &cacheTestEndpoint{captureToken: "b", paths: paths}
+	old := &core.Entry{Kind: core.EntryKind_Directory, Contents: map[string]*core.Entry{
+		"source.txt": {Kind: core.EntryKind_File, Digest: []byte("old")},
+		"link":       {Kind: core.EntryKind_SymbolicLink, Target: "old-target"},
+	}}
+	var cache gitPolicyPreparation
+	first, err := cache.prepare(ctx, a, b, old)
+	if err != nil {
+		t.Fatal(err)
+	}
+	current := proto.Clone(old).(*core.Entry)
+	current.Contents["source.txt"].Digest = []byte("current")
+	current.Contents["source.txt"].Executable = true
+	current.Contents["link"].Target = "current-target"
+	reused, err := cache.prepare(ctx, a, b, current)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reused != first || cache.ancestor != current || a.evaluations != 1 || b.evaluations != 1 || a.small != 1 || b.small != 1 || a.validations != 1 || b.validations != 1 {
+		t.Fatal("content-only archive changes did not reuse policy with current evidence")
+	}
+	projected := filterIgnoredAncestor("", current, reused, false)
+	if projected.Contents["source.txt"] != current.Contents["source.txt"] || projected.Contents["link"] != current.Contents["link"] {
+		t.Fatal("policy projection returned stale archive content")
+	}
+	if !projected.Contents["source.txt"].Executable || string(projected.Contents["source.txt"].Digest) != "current" || projected.Contents["link"].Target != "current-target" {
+		t.Fatal("projection rolled back content, executable mode or symlink target")
+	}
+	// An unchanged peer still contains the current bytes. Removing the file on
+	// alpha must propagate deletion using that current archive baseline.
+	alpha := current.Copy(core.EntryCopyBehaviorShallow)
+	delete(alpha.Contents, "source.txt")
+	_, alphaChanges, betaChanges, conflicts := core.Reconcile(projected, alpha, current, core.SynchronizationMode_SynchronizationModeTwoWaySafe)
+	if len(conflicts) != 0 || len(alphaChanges) != 0 || len(betaChanges) != 1 || betaChanges[0].Path != "source.txt" || betaChanges[0].New != nil {
+		t.Fatal("current archive projection lost ordinary deletion semantics")
+	}
+}
+
+func TestGitPolicyArchiveShapeStructuralChangesRequireJointAdmission(t *testing.T) {
+	base := &core.Entry{Kind: core.EntryKind_Directory, Contents: map[string]*core.Entry{
+		"source.txt": {Kind: core.EntryKind_File},
+		"nested":     {Kind: core.EntryKind_Directory, Contents: map[string]*core.Entry{"child.txt": {Kind: core.EntryKind_File}}},
+	}}
+	for _, kind := range []string{"add", "remove", "rename", "nested-rename", "file-kind", "directory-kind"} {
+		t.Run(kind, func(t *testing.T) {
+			a, b := &cacheTestEndpoint{captureToken: "a", paths: []string{"source.txt", "nested/child.txt"}}, &cacheTestEndpoint{captureToken: "b", paths: []string{"source.txt", "nested/child.txt"}}
+			var cache gitPolicyPreparation
+			if _, err := cache.prepare(context.Background(), a, b, base); err != nil {
+				t.Fatal(err)
+			}
+			current := proto.Clone(base).(*core.Entry)
+			switch kind {
+			case "add":
+				current.Contents["new.txt"] = &core.Entry{Kind: core.EntryKind_File}
+			case "remove":
+				delete(current.Contents, "source.txt")
+			case "rename":
+				current.Contents["renamed.txt"] = current.Contents["source.txt"]
+				delete(current.Contents, "source.txt")
+			case "nested-rename":
+				contents := current.Contents["nested"].Contents
+				contents["other.txt"] = contents["child.txt"]
+				delete(contents, "child.txt")
+			case "file-kind":
+				current.Contents["source.txt"] = &core.Entry{Kind: core.EntryKind_SymbolicLink, Target: "elsewhere"}
+			case "directory-kind":
+				current.Contents["nested"] = &core.Entry{Kind: core.EntryKind_Untracked}
+			}
+			if _, err := cache.prepare(context.Background(), a, b, current); err != nil {
+				t.Fatal(err)
+			}
+			if a.full != 2 || b.full != 2 || a.evaluations != 2 || b.evaluations != 2 || a.installs != 2 || b.installs != 2 {
+				t.Fatal("archive path or kind change reused installed admission")
+			}
+		})
+	}
+	if !sameGitPolicyArchiveShape(nil, nil) || sameGitPolicyArchiveShape(nil, base) || sameGitPolicyArchiveShape(base, nil) {
+		t.Fatal("nil archive shape did not preserve presence semantics")
+	}
+}
+
+func TestGitPolicyArchiveShapeStillRequiresEndpointGeneration(t *testing.T) {
+	ctx := context.Background()
+	for _, kind := range []string{"candidate", "capture-index", "installed", "admission", "validate"} {
+		t.Run(kind, func(t *testing.T) {
+			a, b := &cacheTestEndpoint{captureToken: "a", paths: []string{"source.txt"}}, &cacheTestEndpoint{captureToken: "b", paths: []string{"source.txt"}}
+			old := &core.Entry{Kind: core.EntryKind_Directory, Contents: map[string]*core.Entry{"source.txt": {Kind: core.EntryKind_File, Digest: []byte("old")}}}
+			var cache gitPolicyPreparation
+			if _, err := cache.prepare(ctx, a, b, old); err != nil {
+				t.Fatal(err)
+			}
+			current := proto.Clone(old).(*core.Entry)
+			current.Contents["source.txt"].Digest = []byte("current")
+			switch kind {
+			case "candidate":
+				b.captureToken = "b-new-candidate"
+				b.paths = append(b.paths, "new.log")
+			case "capture-index":
+				b.captureToken = "b-new-index"
+			case "installed":
+				b.installedToken = "foreign-index-generation"
+			case "admission":
+				b.admissionToken = "foreign-joint-generation"
+			case "validate":
+				b.failValidate = true
+			}
+			policy, err := cache.prepare(ctx, a, b, current)
+			if kind == "candidate" || kind == "capture-index" {
+				if err != nil || a.evaluations != 2 || b.evaluations != 2 || a.installs != 2 || b.installs != 2 || cache.ancestor != current {
+					t.Fatalf("changed endpoint skipped joint admission: %v", err)
+				}
+				if kind == "candidate" {
+					if status, _ := policy.Ignore("new.log", false); status != ignore.IgnoreStatusUnignored {
+						t.Fatal("fresh candidate was absent from rebuilt policy")
+					}
+				}
+				return
+			}
+			if !IsGitPolicyRetry(err) || cache.ready {
+				t.Fatalf("foreign or invalid generation was admitted: %v", err)
+			}
+			fullA, fullB := a.full, b.full
+			if _, err := cache.prepare(ctx, a, b, current); err != nil {
+				t.Fatal(err)
+			}
+			if a.full <= fullA || b.full <= fullB {
+				t.Fatal("rejected generation did not force full evidence on both sides")
+			}
+		})
+	}
+}
+
+func TestGitPolicyExactGenerationCache(t *testing.T) {
+	ctx := context.Background()
+	a, b := &cacheTestEndpoint{captureToken: "a", paths: []string{"file.txt"}}, &cacheTestEndpoint{captureToken: "b", paths: []string{"file.txt"}}
+	var cache gitPolicyPreparation
+	ancestor := &core.Entry{Kind: core.EntryKind_Directory, Contents: map[string]*core.Entry{"file.txt": {Kind: core.EntryKind_File}}}
+	first, err := cache.prepare(ctx, a, b, ancestor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := cache.prepare(ctx, a, b, ancestor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first != second || a.evaluations != 1 || b.evaluations != 1 || a.installs != 1 || b.installs != 1 || a.validations != 1 || b.validations != 1 {
+		t.Fatal("identical generation did not reuse joint immutable policy")
+	}
+	// An equal archive shape on a different immutable tree keeps the same
+	// candidate set, but still requires fresh endpoint evidence and validation.
+	copied := proto.Clone(ancestor).(*core.Entry)
+	if _, err := cache.prepare(ctx, a, b, copied); err != nil {
+		t.Fatal(err)
+	}
+	if a.evaluations != 1 || b.evaluations != 1 || a.validations != 2 || b.validations != 2 || cache.ancestor != copied {
+		t.Fatal("equal archive shape did not retain current content and fresh validation")
+	}
+	b.captureToken = "b-next"
+	b.paths = []string{"file.txt", "new.txt"}
+	if _, err := cache.prepare(ctx, a, b, copied); err != nil {
+		t.Fatal(err)
+	}
+	if a.evaluations != 2 || b.evaluations != 2 {
+		t.Fatal("one-side candidate change skipped joint re-evaluation")
+	}
+	// A coherent but unexpected installed generation must never authorize reuse.
+	a.admissionToken = "foreign-generation"
+	if _, err := cache.prepare(ctx, a, b, copied); !IsGitPolicyRetry(err) || cache.ready {
+		t.Fatalf("foreign installed generation accepted: %v", err)
+	}
+	if _, err := cache.prepare(ctx, a, b, copied); err != nil {
+		t.Fatal(err)
+	}
+	b.captureToken = "b-third"
+	b.failInstall = true
+	if _, err := cache.prepare(ctx, a, b, copied); !IsGitPolicyRetry(err) || cache.ready {
+		t.Fatalf("partial installation preserved cache: %v", err)
+	}
+	aFull := a.full
+	bFull := b.full
+	if _, err := cache.prepare(ctx, a, b, copied); err != nil {
+		t.Fatal(err)
+	}
+	if a.full <= aFull || b.full <= bFull {
+		t.Fatal("retry did not request fresh full evidence on both sides")
+	}
+}
