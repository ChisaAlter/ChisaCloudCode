+)
+
+func TestGitPolicyRealRemoteProtocolAndJointAdmission(t *testing.T) {
+	private := t.TempDir()
+	t.Setenv("MUTAGEN_DATA_DIRECTORY", filepath.Join(private, "daemon"))
+	t.Setenv("HOME", private)
+	t.Setenv("USERPROFILE", private)
+	t.Setenv("GIT_CONFIG_GLOBAL", filepath.Join(private, "config"))
+	t.Setenv("GIT_CONFIG_NOSYSTEM", "1")
+	a, b := filepath.Join(private, "alpha"), filepath.Join(private, "beta")
+	for _, root := range []string{a, b} {
+		if err := os.MkdirAll(root, 0700); err != nil {
+			t.Fatal(err)
+		}
+		command := exec.Command("git", "-C", root, "init", "-q")
+		if output, err := command.CombinedOutput(); err != nil {
+			t.Fatalf("git init: %v %s", err, output)
+		}
+		if err := os.WriteFile(filepath.Join(root, ".gitignore"), []byte("*.log\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	configuration := &synchronization.Configuration{Ignores: []string{synchronization.GitPolicyMarker}, WatchMode: synchronization.WatchMode_WatchModeNoWatch}
+	logger := logging.NewLogger(logging.LevelError, io.Discard)
+	alpha, err := local.NewEndpoint(logger, a, "isolated-git-policy-remote", synchronization.DefaultVersion, configuration, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer alpha.Shutdown()
+	client, server := net.Pipe()
+	serverDone := make(chan error, 1)
+	go func() { serverDone <- remote.ServeEndpoint(logger, server) }()
+	beta, err := remote.NewEndpoint(logger, client, b, "isolated-git-policy-remote", synchronization.DefaultVersion, configuration, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { beta.Shutdown(); <-serverDone }()
+	if err := os.WriteFile(filepath.Join(a, "future.log"), []byte("ignored"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := synchronization.PrepareGitPolicy(context.Background(), alpha, beta, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err, _ := beta.Scan(context.Background(), nil, true); err != nil {
+		t.Fatal(err)
+	}
+	command := exec.Command("git", "-C", a, "add", "-f", "future.log")
+	if output, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("git add: %v %s", err, output)
+	}
+	if _, err := synchronization.PrepareGitPolicy(context.Background(), alpha, beta, nil); err != nil {
+		t.Fatal(err)
+	}
+	snapshot, err, _ := alpha.Scan(context.Background(), nil, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if snapshot.Content.Contents["future.log"] == nil {
+		t.Fatal("one-index force track lost across remote policy exchange")
+	}
+	if _, err := beta.(synchronization.GitPolicyEndpoint).GitPolicy(context.Background(), &synchronization.GitPolicyRequest{Operation: "validate"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(b, ".gitignore"), []byte("*.txt\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := beta.(synchronization.GitPolicyEndpoint).GitPolicy(context.Background(), &synchronization.GitPolicyRequest{Operation: "validate"}); err == nil || !synchronization.IsGitPolicyRetry(err) {
+		t.Fatalf("remote policy drift did not preserve coherent retry: %v", err)
+	}
+	if _, err := synchronization.PrepareGitPolicy(context.Background(), alpha, beta, nil); err != nil {
+		t.Fatalf("coherent retry poisoned healthy remote protocol: %v", err)
+	}
+}
