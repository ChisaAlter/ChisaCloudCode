+package synchronization_test
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/mutagen-io/mutagen/pkg/logging"
+	"github.com/mutagen-io/mutagen/pkg/selection"
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+	"github.com/mutagen-io/mutagen/pkg/synchronization/core"
+	_ "github.com/mutagen-io/mutagen/pkg/synchronization/protocols/local"
+	"github.com/mutagen-io/mutagen/pkg/url"
+)
+
+func integrationGit(t *testing.T, root string, args ...string) {
+	t.Helper()
+	command := exec.Command("git", append([]string{"-C", root, "-c", "core.fsmonitor=false"}, args...)...)
+	if output, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("git %v: %v %s", args, err, output)
+	}
+}
+func integrationWrite(t *testing.T, root, name, content string) {
+	t.Helper()
+	target := filepath.Join(root, filepath.FromSlash(name))
+	if err := os.MkdirAll(filepath.Dir(target), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(target, []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+}
+func integrationWait(t *testing.T, manager *synchronization.Manager, id string, condition func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(60 * time.Second)
+	for time.Now().Before(deadline) {
+		if condition() {
+			return
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	_, states, err := manager.List(context.Background(), &selection.Selection{Specifications: []string{id}}, 0)
+	t.Fatalf("autonomous convergence timed out: %v %v", err, states)
+}
+func integrationCycle(t *testing.T, manager *synchronization.Manager, id string) uint64 {
+	t.Helper()
+	_, states, err := manager.List(context.Background(), &selection.Selection{Specifications: []string{id}}, 0)
+	if err != nil || len(states) != 1 {
+		t.Fatalf("state: %v", err)
+	}
+	return states[0].SuccessfulCycles
+}
+func integrationExists(root, name string) bool {
+	_, err := os.Stat(filepath.Join(root, filepath.FromSlash(name)))
+	return err == nil
+}
+func TestGitPolicyAutonomousLocalController(t *testing.T) {
+	private := t.TempDir()
+	t.Setenv("MUTAGEN_DATA_DIRECTORY", filepath.Join(private, "daemon"))
+	t.Setenv("HOME", private)
+	t.Setenv("USERPROFILE", private)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(private, "xdg"))
+	t.Setenv("GIT_CONFIG_GLOBAL", filepath.Join(private, "global-gitconfig"))
+	t.Setenv("GIT_CONFIG_NOSYSTEM", "1")
+	a, b := filepath.Join(private, "alpha"), filepath.Join(private, "beta")
+	for _, root := range []string{a, b} {
+		if err := os.MkdirAll(root, 0700); err != nil {
+			t.Fatal(err)
+		}
+		integrationGit(t, root, "init", "-q")
+		integrationWrite(t, root, ".gitignore", "*.log\nruntime/\n")
+	}
+	integrationWrite(t, a, "baseline.txt", "initial")
+	manager, err := synchronization.NewManager(logging.NewLogger(logging.LevelError, io.Discard))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(manager.Shutdown)
+	configuration := &synchronization.Configuration{Ignores: []string{synchronization.GitPolicyMarker}, SynchronizationMode: core.SynchronizationMode_SynchronizationModeTwoWaySafe, WatchMode: synchronization.WatchMode_WatchModeForcePoll, WatchPollingInterval: 1}
+	id, err := manager.Create(context.Background(), &url.URL{Kind: url.Kind_Synchronization, Protocol: url.Protocol_Local, Path: a}, &url.URL{Kind: url.Kind_Synchronization, Protocol: url.Protocol_Local, Path: b}, configuration, &synchronization.Configuration{}, &synchronization.Configuration{}, "chisa-vps-policy-isolated", nil, false, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// From here onward: only ordinary filesystem/Git writes and state reads.
+	// No Flush, Resume, UpdateIgnores or external sync operation is invoked.
+	integrationWait(t, manager, id, func() bool { return integrationExists(b, "baseline.txt") })
+	before := integrationCycle(t, manager, id)
+	integrationWrite(t, a, "future.log", "never upload before force add")
+	integrationWrite(t, a, "runtime/keep.txt", "tracked exception")
+	integrationWrite(t, a, "runtime/sibling.txt", "must remain ignored")
+	integrationWrite(t, a, "ordinary.txt", "barrier file")
+	integrationWait(t, manager, id, func() bool {
+		return integrationExists(b, "ordinary.txt") && integrationCycle(t, manager, id) >= before+2
+	})
+	if integrationExists(b, "future.log") || integrationExists(b, "runtime/keep.txt") {
+		t.Fatal("ignored path uploaded before force-add")
+	}
+	integrationGit(t, a, "add", "-f", "future.log", "runtime/keep.txt")
+	integrationWait(t, manager, id, func() bool { return integrationExists(b, "future.log") && integrationExists(b, "runtime/keep.txt") })
+	if integrationExists(b, "runtime/sibling.txt") {
+		t.Fatal("force-tracked directory leaked its sibling")
+	}
+	// The peer index stays empty: the one-index override must be sufficient.
+	integrationWrite(t, a, "preserve.txt", "local preserve")
+	integrationWait(t, manager, id, func() bool { return integrationExists(b, "preserve.txt") })
+	integrationWrite(t, a, ".gitignore", "*.log\nruntime/\npreserve.txt\n")
+	integrationWait(t, manager, id, func() bool {
+		data, err := os.ReadFile(filepath.Join(b, ".gitignore"))
+		return err == nil && string(data) == "*.log\nruntime/\npreserve.txt\n"
+	})
+	integrationWrite(t, a, "preserve.txt", "local ignored edit")
+	before = integrationCycle(t, manager, id)
+	integrationWait(t, manager, id, func() bool { return integrationCycle(t, manager, id) >= before+2 })
+	data, err := os.ReadFile(filepath.Join(b, "preserve.txt"))
+	if err != nil || string(data) != "local preserve" {
+		t.Fatalf("newly ignored archive path was deleted/overwritten: %q %v", data, err)
+	}
+	if err := os.Rename(filepath.Join(a, "ordinary.txt"), filepath.Join(a, "renamed.log")); err != nil {
+		t.Fatal(err)
+	}
+	integrationWait(t, manager, id, func() bool { return !integrationExists(b, "ordinary.txt") })
+	if integrationExists(b, "renamed.log") {
+		t.Fatal("rename into ignored pattern uploaded")
+	}
+	integrationWrite(t, a, ".gitignore", "runtime/\npreserve.txt\n")
+	integrationWait(t, manager, id, func() bool { return integrationExists(b, "renamed.log") })
+	for _, name := range []string{".env", "node_modules/pkg/index.js", ".chisa-bridge.json"} {
+		integrationWrite(t, a, name, "secret")
+	}
+	integrationGit(t, a, "add", "-f", ".env", "node_modules/pkg/index.js", ".chisa-bridge.json")
+	before = integrationCycle(t, manager, id)
+	integrationWait(t, manager, id, func() bool { return integrationCycle(t, manager, id) >= before+2 })
+	for _, name := range []string{".env", "node_modules/pkg/index.js", ".chisa-bridge.json"} {
+		if integrationExists(b, name) {
+			t.Fatal(fmt.Sprintf("security exclusion force-tracked: %s", name))
+		}
+	}
+}
