+++ b/cmd/mutagen/sync/update_ignores.go
@@ -0,0 +1,58 @@
+package sync
+
+import (
+	"fmt"
+
+	"github.com/spf13/cobra"
+	"google.golang.org/protobuf/types/known/emptypb"
+
+	"github.com/mutagen-io/mutagen/cmd/mutagen/daemon"
+	"github.com/mutagen-io/mutagen/pkg/grpcutil"
+	"github.com/mutagen-io/mutagen/pkg/identifier"
+	synchronizationsvc "github.com/mutagen-io/mutagen/pkg/service/synchronization"
+	"github.com/mutagen-io/mutagen/pkg/synchronization"
+)
+
+func updateIgnoresMain(command *cobra.Command, arguments []string) error {
+	if !identifier.IsValid(arguments[0]) {
+		return fmt.Errorf("an exact session identifier is required")
+	}
+	configuration, err := loadAndValidateGlobalSynchronizationConfiguration(updateIgnoresConfiguration.configurationFile)
+	if err != nil {
+		return fmt.Errorf("unable to load ignore configuration: %w", err)
+	}
+	connection, err := daemon.Connect(true, true)
+	if err != nil {
+		return fmt.Errorf("unable to connect to daemon: %w", err)
+	}
+	defer connection.Close()
+	request := &synchronization.Session{
+		Identifier:    arguments[0],
+		Configuration: synchronization.IgnoreConfiguration(configuration),
+	}
+	if err := connection.Invoke(command.Context(), synchronizationsvc.IgnoreConfigurationUpdateMethod, request, &emptypb.Empty{}); err != nil {
+		return grpcutil.PeelAwayRPCErrorLayer(err)
+	}
+	return nil
+}
+
+var updateIgnoresCommand = &cobra.Command{
+	Use:          "update-ignores --configuration-file <yaml> <identifier>",
+	Short:        "Replace ignore rules for one paused session without resetting history",
+	Args:         cobra.ExactArgs(1),
+	RunE:         updateIgnoresMain,
+	SilenceUsage: true,
+}
+
+var updateIgnoresConfiguration struct {
+	help              bool
+	configurationFile string
+}
+
+func init() {
+	flags := updateIgnoresCommand.Flags()
+	flags.SortFlags = false
+	flags.BoolVarP(&updateIgnoresConfiguration.help, "help", "h", false, "Show help information")
+	flags.StringVar(&updateIgnoresConfiguration.configurationFile, "configuration-file", "", "Configuration file supplying the replacement sync.defaults.ignore settings")
+	updateIgnoresCommand.MarkFlagRequired("configuration-file")
+}
diff --git a/pkg/filesystem/watching/watch_recursive_linux_inotify.go b/pkg/filesystem/watching/watch_recursive_linux_inotify.go
